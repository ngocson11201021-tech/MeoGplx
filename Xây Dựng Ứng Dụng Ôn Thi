            "CodeContent": "// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n// FRONTEND APP JAVASCRIPT: MẸO THI BẰNG N.SOWN\n// Xử lý toàn bộ logic: Mẹo 3s Siêu Tốc, Thi Thử MoT, VietQR, Admin Dashboard\n// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\nconst app \u003d {\n  // Trạng thái ứng dụng (State)\n  state: {\n    token: localStorage.getItem(\u0027nsown_token\u0027) || \u0027\u0027,\n    user: null,\n    currentTier: localStorage.getItem(\u0027nsown_tier\u0027) || \u0027A1\u0027,\n    currentTab: \u0027home\u0027,\n    settings: {},\n    questions: [],\n    practiceCategory: \u0027all\u0027,\n    signs: [],\n    activeSignCategory: \u0027all\u0027,\n    exam: {\n      active: false,\n      tier: \u0027A1\u0027,\n      config: null,\n      questions: [],\n      currentIndex: 0,\n      userAnswers: {}, // { [question_id]: selected_option_index }\n      timerSeconds: 0,\n      timerInterval: null\n    },\n    adminSubtab: \u0027users\u0027\n  },\n\n  // 1. KHỞI TẠO ỨNG DỤNG (INIT)\n  async init() {\n    console.log(\u0027[App] Khởi tạo Mẹo Thi Bằng N.Sown...\u0027);\n    this.updateTierDisplay();\n    await this.fetchSettings();\n    await this.fetchUserProfile();\n    this.setupEventListeners();\n\n    // Tự động load tab theo URL hash hoặc mặc