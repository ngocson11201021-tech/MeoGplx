            "CodeContent": "-- \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n-- CƠ SỞ DỮ LIỆU: MẸO THI BẰNG N.SOWN\n-- Ứng dụng ôn luyện thi GPLX \u0026 Hệ thống Mẹo trả lời nhanh siêu tốc 3s\n-- \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\n-- 1. BẢNG NGƯỜI DÙNG (USERS)\nCREATE TABLE IF NOT EXISTS users (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    username TEXT UNIQUE NOT NULL,\n    full_name TEXT NOT NULL,\n    phone_or_email TEXT UNIQUE NOT NULL,\n    password_hash TEXT NOT NULL,\n    role TEXT NOT NULL DEFAULT \u0027user\u0027, -- \u0027user\u0027 hoặc \u0027admin\u0027\n    is_vip INTEGER NOT NULL DEFAULT 0,  -- 0: Thường, 1: VIP\n    vip_expire_at TEXT DEFAULT NULL,   -- Ngày hết hạn VIP (NULL là vĩnh viễn)\n    gold_balance INTEGER NOT NULL DEFAULT 0, -- Số dư Gold\n    status TEXT NOT NULL DEFAULT \u0027active\u0027,   -- \u0027active\u0027 hoặc \u0027locked\u0027\n    avatar_url TEXT DEFAULT \u0027\u0027,\n    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);\n\n-- 2. BẢNG CẤU HÌNH HỆ THỐNG (SYSTEM_SETTINGS)\nCREATE TABLE IF NOT EXISTS system_settings (\n    key TEXT PRIMARY KEY,\n    value TEXT NOT NULL,\n    description TEXT,\n    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);\n\n-- 3. BẢNG BỘ CÂU HỎI (QUESTIONS)\nCREATE TABLE IF NOT EXISTS questions (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    license_tiers TEXT NOT NULL DEFAULT \u0027[\"A1\",\"A2\",\"B1\",\"B2\",\"C\"]\u0027, -- JSON array các hạng áp dụng\n    category TEXT NOT NULL, -- \u0027khai_niem\u0027, \u0027quy_tac\u0027, \u0027van_hoa_dao_duc\u0027, \u0027ky_thuat_lai_xe\u0027, \u0027bien_bao\u0027, \u0027sa_hinh\u0027\n    question_text TEXT NOT NULL,\n    image_url TEXT DEFAULT \u0027\u0027, -- URL hoặc SVG của sa hình / biển báo\n    options TEXT NOT NULL, -- JSON array các phương án trả lời: [\"Đáp án 1\", \"Đáp án 2\", ...]\n    correct_option_index INTEGER NOT NULL, -- 0-based index\n    explanation TEXT NOT NULL, -- Giải thích chi tiết theo Luật GTĐB\n    is_critical INTEGER NOT NULL DEFAULT 0, -- 1: Câu điểm liệt (sai là rớt), 0: Thường\n    order_index INTEGER DEFAULT 0,\n    created_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);\n\n-- 4. BẢNG MẸO TRẢ LỜI NHANH 3S (QUICK_TIPS)\n-- Liên kết 1-1 với câu hỏi để cung cấp mẹo nhận diện từ khóa siêu tốc\nCREATE TABLE IF NOT EXISTS quick_tips (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    question_id INTEGER UNIQUE NOT NULL,\n    tip_title TEXT NOT NULL,       -- Ví dụ: \"⚡ Mẹo 3s: Cụm từ cấm tuyệt đối\"\n    tip_keyword TEXT NOT NULL,     -- Ví dụ: \"Bị nghiêm cấm / Không được phép\"\n    tip_rule TEXT NOT NULL,        -- Ví dụ: \"Thấy cụm từ \u0027Bị nghiêm cấm\u0027 -\u003e Khoanh luôn không cần đọc hết câu\"\n    tip_mnemonic TEXT NOT NULL,    -- Ví dụ: \"Thấy \u0027CẤM\u0027 hay \u0027KHÔNG\u0027 -\u003e Quất luôn!\"\n    speed_seconds INTEGER DEFAULT 3, -- 3 giây\n    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n    FOREIGN KEY (question_id) REFERENCES questions(id) ON DELETE CASCADE\n);\n\n-- 5. BẢNG ĐƠN HÀNG \u0026 GIAO DỊCH (ORDERS)\nCREATE TABLE IF NOT EXISTS orders (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    order_code TEXT UNIQUE NOT NULL,\n    user_id INTEGER NOT NULL,\n    order_type TEXT NOT NULL, -- \u0027VIP_UPGRADE\u0027 hoặc \u0027GOLD_DEPOSIT\u0027\n    amount INTEGER NOT NULL,  -- Số tiền VNĐ (VD: 250000)\n    gold_amount INTEGER DEFAULT 0, -- Số Gold quy đổi\n    payment_method TEXT NOT NULL DEFAULT \u0027VIETQR\u0027, -- \u0027VIETQR\u0027 hoặc \u0027GOLD_BALANCE\u0027\n    status TEXT NOT NULL DEFAULT \u0027PENDING\u0027, -- \u0027PENDING\u0027, \u0027COMPLETED\u0027, \u0027REJECTED\u0027\n    qr_url TEXT DEFAULT \u0027\u0027,\n    transfer_content TEXT NOT NULL, -- Nội dung chuyển khoản: VD \"NSOWN VIP 1001\"\n    note TEXT DEFAULT \u0027\u0027,\n    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);\n\n-- 6. BẢNG LỊCH SỬ THI THỬ (EXAM_RECORDS)\nCREATE TABLE IF NOT EXISTS exam_records (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    user_id INTEGER NOT NULL,\n    license_tier TEXT NOT NULL, -- \u0027A1\u0027, \u0027B2\u0027, ...\n    total_questions INTEGER NOT NULL,\n    correct_count INTEGER NOT NULL,\n    score INTEGER NOT NULL,\n    is_passed INTEGER NOT NULL, -- 1: Đạt, 0: Không đạt\n    failed_by_critical INTEGER NOT NULL DEFAULT 0, -- 1 nếu trượt vì sai câu điểm liệt\n    time_spent_seconds INTEGER NOT NULL,\n    user_answers TEXT NOT NULL, -- JSON array\n    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);\n\n-- 7. BẢNG BIỂN BÁO GIAO THÔNG (TRAFFIC_SIGNS)\nCREATE TABLE IF NOT EXISTS traffic_signs (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    code TEXT UNIQUE NOT NULL,   -- Ví dụ: \u0027P.101\u0027, \u0027W.201a\u0027\n    name TEXT NOT NULL,          -- Tên biển báo\n    category TEXT NOT NULL,      -- \u0027cam\u0027, \u0027nguy_hiem\u0027, \u0027hieu_lenh\u0027, \u0027chi_dan\u0027, \u0027phu\u0027\n    image_svg TEXT NOT NULL,     -- Vector SVG chuẩn\n    description TEXT NOT NULL,   -- Chi tiết ý nghĩa\n    created_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);\n\n-- 8. BẢNG MẸO THI TỔNG HỢP THEO CHUYÊN ĐỀ (THEORY_TIPS)\nCREATE TABLE IF NOT EXISTS theory_tips (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    category TEXT NOT NULL, -- \u0027meo_chu\u0027, \u0027meo_bien_bao\u0027, \u0027meo_sa_hinh\u0027\n    title TEXT NOT NULL,\n    content_markdown TEXT NOT NULL,\n    order_index INTEGER DEFAULT 0\n);\n\n-- 9. BẢNG THỐNG KÊ LƯỢT TRUY CẬP (SITE_ANALYTICS)\nCREATE TABLE IF NOT EXISTS site_analytics (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    visited_at DATE DEFAULT CURRENT_DATE,\n    path TEXT,\n    ip TEXT,\n    user_agent TEXT,\n    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP\n);\n",
