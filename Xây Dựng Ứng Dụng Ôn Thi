erId, userName) {\n    this.state.targetGoldUserId \u003d userId;\n    document.getElementById(\u0027adminGoldUserName\u0027).textContent \u003d userName;\n    this.openModal(\u0027modalAdminGold\u0027);\n  },\n\n  async submitAdminGold() {\n    const userId \u003d this.state.targetGoldUserId;\n    const action \u003d document.getElementById(\u0027adminGoldAction\u0027).value;\n    const amount \u003d document.getElementById(\u0027adminGoldAmount\u0027).value;\n\n    try {\n      const res \u003d await fetch(\u0027/api/admin/users/gold\u0027, {\n        method: \u0027POST\u0027,\n        headers: {\n          \u0027Content-Type\u0027: \u0027application/json\u0027,\n          \u0027Authorization\u0027: \u0027Bearer \u0027 + this.state.token\n        },\n        body: JSON.stringify({ user_id: userId, action, amount })\n      });\n      const data \u003d await res.json();\n      if (data.success) {\n        this.showToast(data.message, \u0027success\u0027);\n        this.closeModal(\u0027modalAdminGold\u0027);\n        this.loadAdminUsers();\n      }\n    } catch (e) {\n      this.showToast(\u0027Lỗi thao tác Gold\u0027, \u0027error\u0027);\n    }\n  },\n\n  async toggleUserVip(userId, newVipStatus) {\n    try {\n      const res \u003d await fetch(\u0027/api/admin/users/vip\u0027, {\n        method: \u0027POST\u0027,\n        headers: {\n          \u0027Content-Type\u0027: \u0027application/json\u0027,\n          \u0027Authorization\u0027: \u0027Bearer \u0027 + this.state.token\n        },\n        body: JSON.stringify({ user_id: userId, is_vip: newVipStatus })\n      });\n      const data \u003d await res.json();\n      if (data.success) {\n        this.showToast(data.message, \u0027success\u0027);\n        this.loadAdminUsers();\n      }\n    } catch (e) {}\n  },\n\n  async toggleUserStatus(userId, newStatus) {\n    try {\n      const res \u003d await fetch(\u0027/api/admin/users/status\u0027, {\n        method: \u0027POST\u0027,\n        headers: {\n          \u002