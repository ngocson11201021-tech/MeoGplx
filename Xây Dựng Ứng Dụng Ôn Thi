st.toggle(\u0027active\u0027, btn.textContent.toLowerCase().includes(subtab.slice(0, 3)));\n    });\n    document.querySelectorAll(\u0027.admin-subpane\u0027).forEach(p \u003d\u003e p.classList.remove(\u0027active\u0027));\n\n    const paneMap \u003d {\n      \u0027users\u0027: \u0027asubUsers\u0027,\n      \u0027orders\u0027: \u0027asubOrders\u0027,\n      \u0027settings\u0027: \u0027asubSettings\u0027,\n      \u0027questions\u0027: \u0027asubQuestions\u0027\n    };\n    const target \u003d document.getElementById(paneMap[subtab]);\n    if (target) target.classList.add(\u0027active\u0027);\n\n    if (subtab \u003d\u003d\u003d \u0027users\u0027) this.loadAdminUsers();\n    if (subtab \u003d\u003d\u003d \u0027orders\u0027) this.loadAdminOrders();\n    if (subtab \u003d\u003d\u003d \u0027questions\u0027) this.loadAdminQuestions();\n  },\n\n  async loadAdminUsers(search \u003d \u0027\u0027) {\n    const tbody \u003d document.getElementById(\u0027adminUserTableBody\u0027);\n    tbody.innerHTML \u003d \u0027\u003ctr\u003e\u003ctd colspan\u003d\"8\" class\u003d\"text-center\"\u003eĐang tải danh sách...\u003c/td\u003e\u003c/tr\u003e\u0027;\n    try {\n      const res \u003d await fetch(`/api/admin/users?search\u003d${encodeURIComponent(search)}`, {\n        headers: { \u0027Authorization\u0027: \u0027Bearer \u0027 + this.state.token }\n      });\n      const data \u003d await res.json();\n      if (data.success \u0026\u0026 data.users) {\n        tbody.innerHTML \u003d data.users.map(u \u003d\u003e `\n          \u003ctr\u003e\n            \u003ctd\u003e\u003cstrong\u003e#${u.id}\u003c/strong\u003e\u003c/td\u003e\n            \u003ctd\u003e${u.full_name}\u003c/td\u003e\n            \u003ctd\u003e\u003csmall\u003e${u.phone_or_email}\u003c/small\u003e\u003c/td\u003e\n            \u003ctd\u003e\u003cspan class\u003d\"badge-tag ${u.role \u003d\u003d\u003d \u0027admin\u0027 ? \u0027bg-purple\u0027 : \u0027bg-blue\u0027}\"\u003e${u.role}\u003c/span\u003e\u003c/td\u003e\n         