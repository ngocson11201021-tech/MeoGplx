if (el) el.textContent \u003d formatted;\n      const inp \u003d document.getElementById(\u0027cfgVipPrice\u0027);\n      if (inp) inp.value \u003d s.vip_price;\n    }\n    if (s.free_tip_question_limit) {\n      const inp \u003d document.getElementById(\u0027cfgFreeTipLimit\u0027);\n      if (inp) inp.value \u003d s.free_tip_question_limit;\n    }\n    if (s.bank_name \u0026\u0026 document.getElementById(\u0027cfgBankName\u0027)) {\n      document.getElementById(\u0027cfgBankName\u0027).value \u003d s.bank_name;\n    }\n    if (s.bank_account_no \u0026\u0026 document.getElementById(\u0027cfgBankAccountNo\u0027)) {\n      document.getElementById(\u0027cfgBankAccountNo\u0027).value \u003d s.bank_account_no;\n    }\n    if (s.bank_account_name \u0026\u0026 document.getElementById(\u0027cfgBankAccountName\u0027)) {\n      document.getElementById(\u0027cfgBankAccountName\u0027).value \u003d s.bank_account_name;\n    }\n  },\n\n  // 2. XÁC THỰC NGƯỜI DÙNG \u0026 PROFILE\n  async fetchUserProfile() {\n    if (!this.state.token) {\n      this.renderUserUI(null);\n      return;\n    }\n    try {\n      const res \u003d await fetch(\u0027/api/auth/me\u0027, {\n        headers: { \u0027Authorization\u0027: \u0027Bearer \u0027 + this.state.token }\n      });\n      const data \u003d await res.json();\n      if (data.success \u0026\u0026 data.user) {\n        this.state.user \u003d data.user;\n        this.renderUserUI(data.user);\n      } else {\n        this.logout();\n      }\n    } catch (e) {\n      console.warn(\u0027Lỗi kiểm tra session:\u0027, e);\n    }\n  },\n\n  renderUserUI(user) {\n    const goldText \u003d document.getElementById(\u0027userGoldText\u0027);\n    const vipBadge \u003d document.getElementById(\u0027vipStatusBadge\u0027);\n    const vipText \u003d document.getElementById(\u0027vipBadgeText\u0027);\n    const vipIcon \u003d document.getElementById(\u0027vipBadgeIcon\u0027);\n    const profileName \u003d document.getElementById(\u0027profileName\u0027);\n    const profileContact \u003d document.getElementById(\u0027profileContact\u0027);\n    const profileVipTag \u003d document.getElementById(\u0027profileVipTag\u0027);\n    const profileGoldTag \u003d document.getElementById(\u0027profileGoldTag\u0027);\n    const adminMenu \u003d document.getElementById(\u0027adminMenuEntry\u0027);\n    const pmenuAuthTitle \u003d document.getElementById(\u0027pmenuAuthTitle\u0027);\n    const pmenuAuthDesc \u003d document.getElementById(\u0027pmenuAuthDesc\u0027);\n    const pmenuAuthIcon \u003d document.getElementById(\u0027pmenuAuthIcon\u0027);\n\n    if (user) {\n      goldText.textContent \u003d (user.gold_balance || 0).toLocaleString();\n      profileName.textContent \u003d user.full_name;\n      profileContact.textContent \u003d user.phone_or_email;\n      profileGoldTag.textContent \u003d `🪙 ${(user.gold_balance || 0).toLocaleString()} Gold`;\n\n      if (user.is_vip \u003d\u003d\u003d 1) {\n        vipBadge.className \u003d \u0027vip-badge vip\u0027;\n        vipText.textContent \u003d \u0027VIP\u0027;\n        vipIcon.textContent \u003d \u0027👑\u0027;\n        profileVipTag.className \u003d \u0027badge-tag vip\u0027;\n        profileVipTag.textContent \u003d \u0027👑 Tài khoản VIP (Full Mẹo)\u0027;\n      } else {\n        vipBadge.className \u003d \u0027vip-badge free\u0027;\n        vipText.textContent \u003d \u0027Thường\u0027;\n        vipIcon.textContent \u003d \u0027⭐\u0027;\n        profileVipTag.className \u003d \u0027badge-tag free\u0027;\n        profileVipTag.textContent \u003d \u0027Tài khoản Thường\u0027;\n      }\n\n      // Hiện nút Admin nếu là quyền admin\n      if (user.role \u003d\u003d\u003d \u0027admin\u0027) {\n        adminMenu.style.display \u003d \u0027flex\u0027;\n      } else {\n        adminMenu.style.display \u003d \u0027none\u0027;\n      }\n\n      pmenuAuthTitle.textContent \u003d \u0027Đăng Xuất Tài Khoản\u0027;\n      pmenuAuthDesc.textContent \u003d `Đang đăng nhập: ${user.full_name}`;\n      pmenuAuthIcon.textContent \u003d \u0027🚪\u0027;\n      document.getElementById(\u0027pmenuAuthAction\u0027).onclick \u003d () \u003d\u003e this.logout();\n    } else {\n      goldText.textContent \u003d \u00270\u0027;\n      vipBadge.className \u003d \u0027vip-badge free\u0027;\n      vipText.textContent \u003d \u0027Khách\u0027;\n      vipIcon.textContent \u003d \u0027👤\u0027;\n      profileName.textContent \u003d \u0027Khách Vãng Lai\u0027;\n      profileContact.textContent \u003d \u0027Chưa đăng nhập tài khoản\u0027;\n      profileVipTag.className \u003d \u0027badge-tag free\u0027;\n      profileVipTag.textContent \u003d \u0027Chưa nâng cấp\u0027;\n      profileGoldTag.textContent \u003d \u0027🪙 0 Gold\u0027;\n      adminMenu.style.display \u003d \u0027none\u0027;\n\n      pmenuAuthTitle.textContent \u003d \u0027Đăng Nhập / Đăng Ký\u0027;\n      pmenuAuthDesc.textContent \u003d \u0027Lưu tiến độ học và kích hoạt VIP\u0027;\n      pmenuAuthIcon.textContent \u003d \u0027🔑\u0027;\n      document.getElementById(\u0027pmenuAuthAction\u0027).onclick \u003d () \u003d\u003e this.toggleAuthModal();\n    }\n  },\n\n  async handleAuthSubmit(e) {\n    e.preventDefault();\n    const mode \u003d document.getElementById(\u0027authTabLogin\u0027).classList.contains(\u0027active\u0027) ? \u0027login\u0027 : \u0027register\u0027;\n    const account \u003d document.getElementById(\u0027authAccount\u0027).value.trim();\n    const password \u003d document.getElementById(\u0027authPassword\u0027).value.trim();\n    const fullName \u003d document.getElementById(\u0027authFullName\u0027) ? document.getElementById(\u0027authFullName\u0027).value.trim() : \u0027\u0027;\n\n    const endpoint \u003d mode \u003d\u003d\u003d \u0027login\u0027 ? \u0027/api/auth/login\u0027 : \u0027/api/auth/register\u0027;\n    const payload \u003d mode \u003d\u003d\u003d \u0027login\u0027 \n      ? { phone_or_email: account, password }\n      : { full_name: fullName, phone_or_email: account, password };\n\n    try {\n      const res \u003d await fetch(endpoint, {\n        method: \u0027POST\u0027,\n        headers: { \u0027Content-Type\u0027: \u0027application/json\u0027 },\n        body: JSON.stringify(payload)\n      });\n      const data \u003d await res.json();\n\n      if (data.success) {\n        this.state.token \u003d data.token;\n        this.state.user \u003d data.user;\n        localStorage.setItem(\u0027nsown_token\u0027, data.token);\n        this.renderUserUI(data.user);\n        this.closeModal(\u0027modalAuth\u0027);\n        this.showToast(data.message, \u0027success\u0027);\n        // Tải lại câu hỏi để cập nhật trạng thái Mẹo\n        if (this.state.currentTab \u003d\u003d\u003d \u0027practice\u0027) {\n          this.loadQuestions();\n        }\n      } else {\n        this.showToast(data.message || \u0027Thao tác không thành công\u0027, \u0027error\u0027);\n      }\n    } catch (err) {\n      this.showToast(\u0027Lỗi mạng hoặc kết nối máy chủ\u0027, \u0027error\u0027);\n    }\n  },\n\n  async quickLogin(account, password) {\n    document.getElementById(\u0027authAccount\u0027).value \u003d account;\n    document.getElementById(\u0027authPassword\u0027).value \u003d password;\n    this.switchAuthMode(\u0027login\u0027);\n    document.getElementById(\u0027authForm\u0027).dispatchEvent(new Event(\u0027submit\u0027));\n  },\n\n  logout() {\n    this.state.token \u003d \u0027\u0027;\n    this.state.user \u003d null;\n    localStorage.removeItem(\u0027nsown_token\u0027);\n    this.renderUserUI(null);\n    this.showToast(\u0027Đã đăng xuất tài khoản thành công!\u0027);\n    this.navTo(\u0027home\u0027);\n    if (this.state.currentTab \u003d\u003d\u003d \u0027practice\u0027) {\n      this.loadQuestions();\n    }\n  },\n\n  switchAuthMode(mode) {\n    const tabLogin \u003d document.getElementById(\u0027authTabLogin\u0027);\n    const tabRegister \u003d document.getElementById(\u0027authTabRegister\u0027);\n    const groupFullName \u003d document.get