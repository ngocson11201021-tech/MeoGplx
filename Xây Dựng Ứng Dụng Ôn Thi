  if (bnav) bnav.classList.add(\u0027active\u0027);\n\n    // Kích hoạt dữ liệu theo từng tab\n    if (tabName \u003d\u003d\u003d \u0027practice\u0027) {\n      if (options.category) this.state.practiceCategory \u003d options.category;\n      if (options.critical) this.state.practiceCategory \u003d \u0027critical\u0027;\n      this.loadQuestions();\n    } else if (tabName \u003d\u003d\u003d \u0027exam\u0027) {\n      this.resetExamView();\n    } else if (tabName \u003d\u003d\u003d \u0027signs\u0027) {\n      this.loadTrafficSigns();\n    } else if (tabName \u003d\u003d\u003d \u0027theory-tips\u0027) {\n      this.loadTheoryTips();\n    } else if (tabName \u003d\u003d\u003d \u0027admin\u0027) {\n      this.loadAdminDashboard();\n    }\n\n    window.scrollTo({ top: 0, behavior: \u0027smooth\u0027 });\n  },\n\n  // 4. CHỌN HẠNG BẰNG LÁI (A1, A2, B1, B2, C...)\n  selectTier(tier) {\n    this.state.currentTier \u003d tier;\n    localStorage.setItem(\u0027nsown_tier\u0027, tier);\n    this.updateTierDisplay();\n    this.closeModal(\u0027modalTierSelect\u0027);\n    this.showToast(`Đã chuyển sang ôn luyện Hạng ${tier}`);\n\n    // Reload nếu đang ở tab ôn tập hoặc thi thử\n    if (this.state.currentTab \u003d\u003d\u003d \u0027practice\u0027) this.loadQuestions();\n    if (this.state.currentTab \u003d\u003d\u003d \u0027exam\u0027) this.resetExamView();\n  },\n\n  updateTierDisplay() {\n    const tier \u003d this.state.currentTier;\n    document.getElementById(\u0027currentTierBadge\u0027).textContent \u003d tier;\n    document.querySelectorAll(\u0027.current-tier-text\u0027).forEach(el \u003d\u003e el.textContent \u003d tier);\n\n    // Cập nhật quy chuẩn thi tương ứng\n    const rules \u003d {\n      \u0027A1\u0027: { total: \u002725 câu\u0027, time: \u002719 phút\u0027, pass: \u002721/25 câu\u0027 },\n      \u0027A2\u0027: { total: \u002725 câu\u0027, time: \u002719 phút\u0027, pass: \u002723/25 câu\u0027 },\n      \u0027B1\u0027: { total: \u002730 câu\u0027, time: \u002720 phút\u0027, pass: \u002726/30 câu\u0027 },\n      \u0027B2\u0027: { total: \u002735 câu\u0027, time: \u002722 phút\u0027, pass: \u002732/35 câu\u0027 },\n      \u0027C\u0027:  { total: \u002740 câu\u0027, time: \u002724 phút\u0027, pass: \u002736/40 câu\u0027 }\n    };\n    const r \u003d rules[tier] || rules[\u0027A1\u0027];\n    if (document.getElementById(\u0027examRuleTotal\u0027)) {\n      document.getElementById(\u0027examRuleTotal\u0027).textContent \u003d r.total;\n      document.getElementById(\u0027examRuleTime\u0027).textContent \u003d r.time;\n      document.getElementById(\u0027examRulePass\u0027).textContent \u003d r.pass;\n    }\n  },\n\n  // \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n  // 5. ÔN TẬP \u0026 TÍNH NĂNG CỐT LÕI: MẸO TRẢ LỜI NHANH 3S TỪNG CÂU\n  // \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n  async loadQuestions() {\n    const container \u003d document.getElementById(\u0027questionsContainer\u0027);\n    container.innerHTML \u003d \u0027\u003cdiv class\u003d\"loading-spinner\"\u003e⚡ Đang tải câu hỏi \u0026 Mẹo trả lời nhanh siêu tốc...\u003c/div\u003e\u0027;\n\n    let url \u003d `/api/questions?tier\u003d${this.state.currentTier}`;\n    if (this.state.practiceCategory \u003d\u003d\u003d \u0027critical\u0027) {\n      url +\u003d \u0027\u0026critical\u003d1\u0027;\n    } else if (this.state.practiceCategory !\u003d\u003d \u0027all\u0027) {\n      url +\u003d `\u0026category\u003d${this.state.practiceCategory}`;\n    }\n\n    try {\n      const headers \u003d {};\n      if (this.state.token) headers[\u0027Authorization\u0027] \u003d \u0027Bearer \u0027 + this.state.token;\n\n      const res \u003d await fetch(url, { headers });\n      const data \u003d await res.json();\n\n      if (data.success \u0026\u0026 data.questions) {\n        this.state.questions \u003d data.questions;\n        this.renderPracticeQuestions(data.questions, data.user_is_vip, data.free_tip_limit);\n      }\n    } catch (e) {\n      container.innerHTML \u003d \u0027\u003cdiv class\u003d\"text-danger p-3 text-center\"\u003eKhông thể tải dữ liệu câu hỏi. Vui lòng thử lại!\u003c/div\u003e\u0027;\n    }\n  },\n\n  renderPracticeQuestions(questions, isVip, freeLimit) {\n    const container \u003d document.getElementById(\u0027questionsContainer\u0027);\n    const vipStatusBar \u003d document.getElementById(\u0027practiceVipStatusBar\u0027);\n    const vbarMessage \u003d document.getElementById(\u0027vbarMessage\u0027);\n\n    // Cập nhật thanh trạng thái VIP trên đầu\n    if (isVip) {\n      vipStatusBar.className \u003d \u0027vip-status-bar vip\u0027;\n      vbarMessage.innerHTML \u003d \u0027👑 \u003cstrong\u003eTài khoản VIP\u003c/strong\u003e: Đang mở khóa Full 100% Mẹo 3s cho toàn bộ câu hỏi!\u0027;\n    } else {\n      vipStatusBar.className \u003d \u0027vip-status-bar free\u0027;\n      vbarMessage.innerHTML \u003d `⭐ \u003cstrong\u003eTài khoản Thường\u003c/strong\u003e: Bạn xem được Mẹo 3s của \u003cstrong\u003e${freeLimit || 3} câu đầu tiên\u003c/strong\u003e. Nâng VIP để mở trọn bộ!`;\n    }\n\n    if (!questions || questions.length \u003d\u003d\u003d 0) {\n      container.innerHTML \u003d \u0027\u003cdiv class\u003d\"text-muted p-4 text-center\"\u003eKhông tìm thấy câu hỏi nào trong mục này.\u003c/div\u003e\u0027;\n      return;\n    }\n\n    let html \u003d \u0027\u0027;\n    questions.forEach((q, qIndex) \u003d\u003e {\n      const qNum \u003d q.question_number || (qIndex + 1);\n      const isCritical \u003d q.is_critical \u003d\u003d\u003d 1;\n\n      // Sinh hình ảnh hoặc SVG\n      let imageHtml \u003d \u0027\u0027;\n      if (q.image_url) {\n        if (q.image_url \u003d\u003d\u003d \u0027svg_signs_w208\u0027) {\n          imageHtml \u003d `\u003cdiv class\u003d\"q-image-container\"\u003e\n            \u003csvg viewBox\u003d\"0 0 100 100\" width\u003d\"120\" height\u003d\"120\"\u003e\n              \u003cpolygon points\u003d\"50,92 8,18 92,18\" fill\u003d\"#ffd600\" stroke\u003d\"#d50000\" stroke-width\u003d\"8\" stroke-linejoin\u003d\"round\" /\u003e\n            \u003c/svg\u003e\n          \u003c/div\u003e`;\n        } else if (q.image_url.startsWith(\u0027svg_\u0027)) {\n          imageHtml \u003d `\u003cdiv class\u003d\"q-image-container\"\u003e\n            \u003csvg viewBox\u003d\"0 0 180 120\" width\u003d\"180\" height\u003d\"120\"\u003e\n              \u003crect width\u003d\"180\" height\u003d\"120\" fill\u003d\"#334155\" rx\u003d\"8\" /\u003e\n              \u003cline x1\u003d\"90\" y1\u003d\"0\" x2\u003d\"90\" y2\u003d\"120\" stroke\u003d\"#ffffff\" stroke-dasharray\u003d\"8 6\" stroke-width\u003d\"2\"/\u003e\n              \u003cline x1\u003d\"0\" y1\u003d\"60\" x2\u003d\"180\" y2\u003d\"60\" stroke\u003d\"#ffffff\" stroke-dasharray\u003d\"8 6\" stroke-width\u003d\"2\"/\u003e\n              \u003c!-- Xe biểu diễn sa hình --\u003e\n              \u003crect x\u003d\"95\" y\u003d\"70\" width\u003d\"30\" height\u003d\"20\" rx\u003d\"4\" fill\u003d\"#3b82f6\" /\u003e\n              \u003ctext x\u003d\"110\" y\u003d\"84\" font-size\u003d\"9\" fill\u003d\"#fff\" font-weight\u003d\"bold\" text-anchor\u003d\"middle\"\u003eXe con\u003c/text\u003e\n              \u003crect x\u003d\"55\" y\u003d\"30\" width\u003d\"30\" height\u003d\"20\" rx\u003d\"4\" fill\u003d\"#ef4444\" /\u003e\n              \u003ctext x\u003d\"70\" y\u003d\"44\" font-size\u003d\"9\" fill\u003d\"#fff\" font-weight\u003d\"bold\" text-anchor\u003d\"middle\"\u003eQuân sự\u003c/text\u003e\n            \u003c/svg\u003e\n          \u003c/div\u003e`;\n        } else {\n          imageHtml \u003d `\u003cdiv class\u003d\"q-image-container\"\u003e\u003cimg src\u003d\"${q.image_url}\" alt\u003d\"Hình ảnh câu hỏi\" style\u003d\"max-height:160px; border-radius:8px;\"\u003e\u003c/div\u003e`;\n        }\n      }\n\n      // Render danh sách các phương án\n      let optionsHtml \u003d \u0027\u0027;\n      q.options.forEach((optText, optIdx) \u003d\u003e {\n        optionsHtml +\u003d `\n          \u003cdiv class\u003d\"option-item\" id\u003d\"opt_${q.id}_${optIdx}\" onclick\u003d\"app.selectOption(${q.id}, ${optIdx}, ${q.correct_option_index})\"\u003e\n            \u003cspan class\u003d\"opt-radio-circle\"\u003e\u003c/span\u003e\n            \u003cspan class\u003d\"opt-text\"\u003e${optText}\u003c/span\u003e\n          \u003c/div\u003e\n        `;\n      });\n\n      // Render KHUNG MẸO TRẢ LỜI NHANH 3S ĐỘC QUYỀN\n      let tipHtml \u003d \u0027\u0027;\n      if (q.quick_tip) {\n        if (!q.is_tip_locked) {\n          // Trạng thái: MỞ KHÓA MẸO (User VIP hoặc 3 câu đầu tiên của User Thường)\n          tipHtml \u003d `\n            \u003cdiv class\u003d\"quick-tip-card\" id\u003d\"tipBox_${q.id}\"\u003e\n              \u003cdiv class\u003d\"quick-tip-header\"\u003e\n                \u003cdiv class\u003d\"qtip-title\"\u003e\n                  \u003cspan\u003e⚡\u003c/span\u003e\n                  \u003cspan\u003eMẸO TRẢ LỜI NHANH CÂU NÀY:\u003c/span\u003e\n                \u003c/div\u003e\n                \u003cspan class\u003d\"qtip-speed-badge\"\u003e⚡ ${q.quick_tip.speed_seconds || 3} GIÂY\u003c/span\u003e\n              \u003c/div\u003e\n              \u003cdiv class\u003d\"quick-tip-body\"\u003e\n                \u003cdiv class\u003d\"tip-keyword-row\"\u003e\n                  \u003cspan class\u003d\"keyword-label\"\u003e👉 Dấu hiệu từ khóa:\u003c/span\u003e\n                  \u003cspan class\u003d\"keyword-tag\"\u003e${q.quick_tip.keyword}\u003c/span\u003e\n                \u003c/div\u003e\n                \u003cdiv class\u003d\"tip-rule-box\"\u003e\n                  \u003cstrong\u003e💡 Cách khoanh nhanh 3s:\u003c/strong\u003e ${q.quick_tip.rule}\n                \u003c/div\u003e\n                ${q.quick_tip.mnemonic ? `\u003cdiv class\u003d\"tip-mnemonic-text\"\u003e📌 Thần chú: \"${q.quick_tip.mnemonic}\"\u003c/div\u003e` : \u0027\u0027}\n              \u003c/div\u003e\n            \u003c/div\u003e\n          `;\n        } else {\n          // Trạng thái: BỊ KHÓA MẸO (User Thường từ câu thứ 4 trở đi)\n          tipHtml \u003d `\n            \u003cdiv class\u003d\"quick-tip-card locked\" id\u003d\"tipBox_${q.id}\"\u003e\n              \u003cdiv class\u003d\"quick-tip-header\"\u003e\n                \u003cdiv class\u003d\"qtip-title\"\u003e\n                  \u003cspan\u003e⚡\u003c/span\u003e\n                  \u003cspan\u003eMẸO TRẢ LỜI NHANH CÂU NÀY:\u003c/span\u003e\n                \u003c/div\u003e\n                \u003cspan class\u003d\"qtip-speed-badge\"\u003e🔒 ĐÃ KHÓA\u003c/span\u003e\n              \u003c/div\u003e\n              \u003cdiv class\u003d\"quick-tip-body\"\u003e\n                \u003cdiv class\u003d\"tip-keyword-row\"\u003e\n                  \u003cspan class\u003d\"keyword-label\"\u003eDấu hiệu nhận biết:\u003c/span\u003e\n                  \u003cspan class\u003d\"keyword-tag\"\u003eTỪ KHÓA ĐÃ BỊ KHÓA\u003c/span\u003e\n                \u003c/div\u003e\n                \u003cdiv class\u003d\"tip-rule-box\"\u003e\n                  Nội dung mẹo khoanh siêu tốc 3 giây đã bị ẩn...\n                \u003c/div\u003e\n              \u003c/div\u003e\n\n              \u003c!-- Lớp phủ thông báo nâng cấp VIP theo đúng yêu cầu --\u003e\n              \u003cdiv class\u003d\"tip-lock-overlay\"\u003e\n                \u003cdiv class\u003d\"lock-shield-icon\"\u003e🔒\u003c/div\u003e\n                \u003cdiv class\u003d\"lock-title-text\"\u003eKHÓA MẸO TRẢ LỜI NHANH!\u003c/div\u003e\n                \u003cdiv class\u003d\"lock-desc-text\"\u003e\n                  Nâng cấp gói VIP (250.000đ) để xem full 100% mẹo khoanh siêu tốc bao đậu cho toàn bộ câu hỏi.\n                \u003c/div\u003e\n                \u003cbutton class\u003d\"btn-lock-upgrade\" onclick\u003d\"app.showVipModal()\"\u003e\n                  👑 Nâng Cấp Gói VIP Ngay (250.000đ)\n                \u003c/button\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n          `;\n        }\n      }\n\n      html +\u003d `\n        \u003cdiv class\u003d\"question-card\" id\u003d\"qcard_${q.id}\"\u003e\n          \u003cdiv class\u003d\"qcard-header\"\u003e\n            \u003cspan class\u003d\"q-badge-num\"\u003eCâu ${qNum}\u003c/span\u003e\n            ${isCritical ? \u0027\u003cspan class\u003d\"q-badge-critical\"\u003e🚨 CÂU ĐIỂM LIỆT\u003c/span\u003e\u0027 : \u0027\u0027}\n          \u003c/div\u003e\n\n          \u003cdiv class\u003d\"q-text\"\u003e${q.question_text}\u003c/div\u003e\n          ${imageHtml}\n\n          \u003cdiv class\u003d\"options-list\"\u003e\n            ${optionsHtml}\n          \u003c/div\u003e\n\n          \u003c!-- MẸO KHOANH NHANH 3S NỔI BẬT DƯỚI CÂU HỎI --\u003e\n          ${tipHtml}\n\n          \u003cbutton class\u003d\"explanation-toggle-btn\" onclick\u003d\"app.toggleExplanation(${q.id})\"\u003e\n            🔍 Xem giải thích chi tiết theo Luật GTĐB\n          \u003c/button\u003e\n          \u003cdiv class\u003d\"explanation-box\" id\u003d\"explain_${q.id}\" style\u003d\"display: none;\"\u003e\n            ${q.explanation}\n          \u003c/div\u003e\n        \u003c/div\u003e\n      `;\n    });\n\n    container.innerHTML \u003d html;\n  },\n\n  // Chọn đáp án trong chế độ Ôn tập\n  selectOption(qId, selectedIdx, correctIdx) {\n    const parentCard \u003d document.getElementById(`qcard_${qId}`);\n    if (!parentCard) return;\n\n    // Reset style các options trong câu\n    parentCard.querySelectorAll(\u0027.option-item\u0027).forEach(el \u003d\u003e {\n      el.classList.remove(\u0027selected\u0027, \u0027correct\u0027, \u0027wrong\u0027);\n    });\n\n    const chosenOption \u003d document.getElementById(`opt_${qId}_${selectedIdx}`);\n    const correctOption \u003d document.getElementById(`opt_${qId}_${correctIdx}`);\n\n    if (selectedIdx \u003d\u003d\u003d correctIdx) {\n      if (chosenOption) chosenOption.classList.add(\u0027correct\u0027);\n    } else {\n      if (chosenOption) chosenOption.classList.add(\u0027wrong\u0027);\n      if (correctOption) correctOption.classList.add(\u0027correct\u0027);\n    }\n\n    // Cuộn nhẹ xuống để người học chú ý đến Khung Mẹo 3s\n    const tipBox \u003d document.getElementById(`tipBox_${qId}`);\n    if (tipBox) {\n      tipBox.style.transform \u003d \u0027scale(1.02)\u0027;\n      setTimeout(() \u003d\u003e { tipBox.style.transform \u003d \u0027scale(1)\u0027; }, 250);\n    }\n  },\n\n  toggleExplanation(qId) {\n    const box \u003d document.getElementById(`explain_${qId}`);\n    if (box) {\n      box.style.display \u003d box.style.display \u003d\u003d\u003d \u0027none\u0027 ? \u0027block\u0027 : \u0027none\u0027;\n    }\n  },\n\n  filterPractice(cat) {\n    this.state.practiceCategory \u003d cat;\n    document.querySelectorAll(\u0027.filter-pill\u0027).forEach(el \u003d\u003e {\n      el.classList.toggle(\u0027active\u0027, el.dataset.cat \u003d\u003d\u003d cat);\n    });\n    this.loadQuestions();\n  },\n\n  // \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n  // 6. THI THỬ SÁT HẠCH CHUẨN BỘ GTVT\n  // \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n  resetExamView() {\n    if (this.state.exam.timerInterval) {\n      clearInterval(this.state.exam.timerInterval);\n    }\n    document.getElementById(\u0027examIntroView\u0027).style.display \u003d \u0027block\u0027;\n    document.getElementById(\u0027examActiveView\u0027).style.display \u003d \u0027none\u0027;\n    document.getElementById(\u0027examResultView\u0027).style.display \u003d \u0027none\u0027;\n    this.updateTierDisplay();\n  },\n\n  async startExam() {\n    const tier \u003d this.state.currentTier;\n    try {\n      const res \u003d await fetch(`/api/exams/generate?tier\u003d${tier}`);\n      const data \u003d await res.json();\n\n      if (data.success \u0026\u0026 data.exam) {\n        this.state.exam.active \u003d true;\n        this.state.exam.tier \u003d tier;\n        this.state.exam.config \u003d data.exam.config;\n        this.state.exam.questions \u003d data.exam.questions;\n        this.state.exam.currentIndex \u003d 0;\n        this.state.exam.userAnswers \u003d {};\n        this.state.exam.timerSeconds \u003d data.exam.config.time_minutes * 60;\n\n        document.getElementById(\u0027examIntroView\u0027).style.display \u003d \u0027none\u0027;\n        document.getElementById(\u0027examActiveView\u0027).style.display \u003d \u0027block\u0027;\n        document.getElementById(\u0027examResultView\u0027).style.display \u003d \u0027none\u0027;\n\n        this.startExamTimer();\n        this.renderExamCurrentQuestion();\n        this.renderExamPalette();\n      }\n    } catch (e) {\n      this.showToast(\u0027Không thể tạo đề thi thử. Vui lòng thử lại!\u0027, \u0027error\u0027);\n    }\n  },\n\n  startExamTimer() {\n    if (this.state.exam.timerInterval) clearInterval(this.state.exam.timerInterval);\n\n    const updateTimer \u003d () \u003d\u003e {\n      const m \u003d Math.floor(this.state.exam.timerSeconds / 60);\n      const s \u003d this.state.exam.timerSeconds % 60;\n      document.getElementById(\u0027examTimerDisplay\u0027).textContent \u003d `${String(m).padStart(2, \u00270\u0027)}:${String(s).padStart(2, \u00270\u0027)}`;\n\n      if (this.state.exam.timerSeconds \u003c\u003d 0) {\n        clearInterval(this.state.exam.timerInterval);\n        this.showToast(\u0027Hết giờ làm bài! Tự động nộp bài thi.\u0027, \u0027warning\u0027);\n        this.submitExam();\n      }\n      this.state.exam.timerSeconds--;\n    };\n\n    updateTimer();\n    this.state.exam.timerInterval \u003d setInterval(updateTimer, 1000);\n  },\n\n  renderExamCurrentQuestion() {\n    const { questions, currentIndex, userAnswers } \u003d this.state.exam;\n    const q \u003d questions[currentIndex];\n    if (!q) return;\n\n    document.getElementById(\u0027examCurrentIndex\u0027).textContent \u003d currentIndex + 1;\n    document.getElementById(\u0027examTotalIndex\u0027).textContent \u003d questions.length;\n\n    const container \u003d document.getElementById(\u0027examQuestionCard\u0027);\n    const selectedOpt \u003d userAnswers[q.id];\n\n    let optionsHtml \u003d \u0027\u0027;\n    q.options.forEach((optText, optIdx) \u003d\u003e {\n      const isSelected \u003d selectedOpt \u003d\u003d\u003d optIdx;\n      optionsHtml +\u003d `\n        \u003cdiv class\u003d\"option-item ${isSelected ? \u0027selected\u0027 : \u0027\u0027}\" onclick\u003d\"app.selectExamAnswer(${q.id}, ${optIdx})\"\u003e\n          \u003cspan class\u003d\"opt-radio-circle\"\u003e\u003c/span\u003e\n          \u003cspan class\u003d\"opt-text\"\u003e${optText}\u003c/span\u003e\n        \u003c/div\u003e\n      `;\n    });\n\n    container.innerHTML \u003d `\n      \u003cdiv class\u003d\"qcard-header\"\u003e\n        \u003cspan class\u003d\"q-badge-num\"\u003eCâu ${currentIndex + 1} / ${questions.length}\u003c/span\u003e\n        ${q.is_critical ? \u0027\u003cspan class\u003d\"q-badge-critical\"\u003e🚨 CÂU ĐIỂM LIỆT\u003c/span\u003e\u0027 : \u0027\u0027}\n      \u003c/div\u003e\n      \u003cdiv class\u003d\"q-text\"\u003e${q.question_text}\u003c/div\u003e\n      \u003cdiv class\u003d\"options-list\"\u003e${optionsHtml}\u003c/div\u003e\n      \u003cdiv class\u003d\"d-flex justify-content-between mt-3\" style\u003d\"display:flex; justify-content:space-between;\"\u003e\n        \u003cbutton class\u003d\"btn btn-outline btn-sm\" onclick\u003d\"app.prevExamQuestion()\" ${currentIndex \u003d\u003d\u003d 0 ? \u0027disabled\u0027 : \u0027\u0027}\u003e‹ Câu Trước\u003c/button\u003e\n        \u003cbutton class\u003d\"btn btn-primary btn-sm\" onclick\u003d\"app.nextExamQuestion()\" ${currentIndex \u003d\u003d\u003d questions.length - 1 ? \u0027disabled\u0027 : \u0027\u0027}\u003eCâu Tiếp ›\u003c/button\u003e\n      \u003c/div\u003e\n    `;\n  },\n\n  renderExamPalette() {\n    const { questions, currentIndex, userAnswers } \u003d this.state.exam;\n    const grid \u003d document.getElementById(\u0027examPaletteGrid\u0027);\n    let html \u003d \u0027\u0027;\n\n    questions.forEach((q, idx) \u003d\u003e {\n      const isAnswered \u003d userAnswers[q.id] !\u003d\u003d undefined;\n      const isCurrent \u003d idx \u003d\u003d\u003d currentIndex;\n      let cls \u003d \u0027palette-btn\u0027;\n      if (isCurrent) cls +\u003d \u0027 current\u0027;\n      if (isAnswered) cls +\u003d \u0027 answered\u0027;\n\n      html +\u003d `\u003cbutton class\u003d\"${cls}\" onclick\u003d\"app.jumpToExamQuestion(${idx})\"\u003e${idx + 1}\u003c/button\u003e`;\n    });\n\n    grid.innerHTML \u003d html;\n  },\n\n  selectExamAnswer(qId, optIdx) {\n    this.state.exam.userAnswers[qId] \u003d optIdx;\n    this.renderExamCurrentQuestion();\n    this.renderExamPalette();\n  },\n\n  nextExamQuestion() {\n    if (this.state.exam.currentIndex \u003c this.state.exam.questions.length - 1) {\n      this.state.exam.currentIndex++;\n      this.renderExamCurrentQuestion();\n      this.renderExamPalette();\n    }\n  },\n\n  prevExamQuestion() {\n    if (this.state.exam.currentIndex \u003e 0) {\n      this.state.exam.currentIndex--;\n      this.renderExamCurrentQuestion();\n      this.renderExamPalette();\n    }\n  },\n\n  jumpToExamQuestion(idx) {\n    this.state.exam.currentIndex \u003d idx;\n    this.renderExamCurrentQuestion();\n    this.renderExamPalette();\n  },\n\n  confirmSubmitExam() {\n    const answeredCount \u003d Object.keys(this.state.exam.userAnswers).length;\n    const total \u003d this.state.exam.questions.length;\n    if (confirm(`Bạn đã làm ${answeredCount}/${total} câu hỏi. Bạn có chắc chắn muốn nộp bài thi ngay bây giờ?`)) {\n      this.submitExam();\n    }\n  },\n\n  async submitExam() {\n    if (this.state.exam.timerInterval) clearInterval(this.state.exam.timerInterval);\n\n    const answersPayload \u003d this.state.exam.questions.map(q \u003d\u003e ({\n      question_id: q.id,\n      selected_option_index: this.state.exam.userAnswers[q.id] !\u003d\u003d undefined ? this.state.exam.userAnswers[q.id] : -1\n    }));\n\n    const timeSpent \u003d (this.state.exam.config.time_minutes * 60) - Math.max(0, this.state.exam.timerSeconds);\n\n    try {\n      const headers \u003d { \u0027Content-Type\u0027: \u0027application/json\u0027 };\n      if (this.state.token) headers[\u0027Authorization\u0027] \u003d \u0027Bearer \u0027 + this.state.token;\n\n      const res \u003d await fetch(\u0027/api/exams/submit\u0027, {\n        method: \u0027POST\u0027,\n        headers,\n        body: JSON.stringify({\n          license_tier: this.state.exam.tier,\n          answers: answersPayload,\n          time_spent_seconds: timeSpent\n        })\n      });\n\n      const data \u003d await res.json();\n      if (data.success) {\n        this.renderExamResult(data.summary, data.review);\n      }\n    } catch (e) {\n      this.showToast(\u0027Lỗi khi chấm điểm bài thi!\u0027, \u0027error\u0027);\n    }\n  },\n\n  renderExamResult(summary, review) {\n    document.getElementById(\u0027examActiveView\u0027).style.display \u003d \u0027none\u0027;\n    document.getElementById(\u0027examResultView\u0027).style.display \u003d \u0027block\u0027;\n\n    const statusCard \u003d document.getElementById(\u0027resultStatusCard\u0027);\n    const resultIcon \u003d document.getElementById(\u0027resultIcon\u0027);\n    const resultTitle \u003d document.getElementById(\u0027resultTitle\u0027);\n    const resultScore \u003d document.getElementById(\u0027resultScore\u0027);\n    const resultNote \u003d document.getElementById(\u0027resultNote\u0027);\n\n    if (summary.is_passed) {\n      statusCard.className \u003d \u0027result-status-card pass\u0027;\n      resultIcon.textContent \u003d \u0027🎉\u0027;\n      resultTitle.textContent \u003d \u0027ĐẠT KẾT QUẢ SÁT HẠCH\u0027;\n      resultNote.textContent \u003d \u0027Chúc mừng bạn! Bạn đã vượt qua bài thi chuẩn Bộ GTVT.\u0027;\n    } else {\n      statusCard.className \u003d \u0027result-status-card fail\u0027;\n      resultIcon.textContent \u003d \u0027❌\u0027;\n      resultTitle.textContent \u003d \u0027KHÔNG ĐẠT YÊU CẦU\u0027;\n      if (summary.failed_by_critical) {\n        resultNote.textContent \u003d \u0027Rất tiếc! Bạn đã trả lời sai câu điểm liệt nên không đạt.\u0027;\n      } else {\n        resultNote.textContent \u003d `Chưa đủ điểm đạt (${summary.correct_count}/${summary.pass_threshold} câu). Hãy luyện thêm Mẹo 3s!`;\n      }\n    }\n\n    resultScore.textContent \u003d `${summary.correct_count} / ${summary.total_questions} Câu`;\n    this.state.examLastReview \u003d review;\n  },\n\n  showExamReview() {\n    const container \u003d document.getElementById(\u0027examReviewContainer\u0027);\n    container.style.display \u003d \u0027block\u0027;\n    const review \u003d this.state.examLastReview || [];\n\n    let html \u003d \u0027\u003ch3 class\u003d\"section-title\"\u003eChi Tiết Từng Câu Hỏi \u0026 Mẹo 3s\u003c/h3\u003e\u0027;\n    review.forEach(r \u003d\u003e {\n      let optionsHtml \u003d \u0027\u0027;\n      r.options.forEach((optText, optIdx) \u003d\u003e {\n        let cls \u003d \u0027option-item\u0027;\n        if (optIdx \u003d\u003d\u003d r.correct_option_index) cls +\u003d \u0027 correct\u0027;\n        if (optIdx \u003d\u003d\u003d r.user_selected_index \u0026\u0026 optIdx !\u003d\u003d r.correct_option_index) cls +\u003d \u0027 wrong\u0027;\n        optionsHtml +\u003d `\u003cdiv class\u003d\"${cls}\"\u003e\u003cspan class\u003d\"opt-text\"\u003e${optText}\u003c/span\u003e\u003c/div\u003e`;\n      });\n\n      let tipHtml \u003d \u0027\u0027;\n      if (r.quick_tip \u0026\u0026 !r.is_tip_locked) {\n        tipHtml \u003d `\n          \u003cdiv class\u003d\"quick-tip-card\"\u003e\n            \u003cdiv class\u003d\"quick-tip-header\"\u003e\n              \u003cspan\u003e⚡ MẸO TRẢ LỜI NHANH 3S CÂU NÀY:\u003c/span\u003e\n              \u003cspan class\u003d\"qtip-speed-badge\"\u003e⚡ 3 GIÂY\u003c/span\u003e\n            \u003c/div\u003e\n            \u003cdiv class\u003d\"quick-tip-body\"\u003e\n              \u003cdiv class\u003d\"tip-keyword-row\"\u003e\u003cspan class\u003d\"keyword-tag\"\u003e${r.quick_tip.keyword}\u003c/span\u003e\u003c/div\u003e\n              \u003cdiv class\u003d\"tip-rule-box\"\u003e${r.quick_tip.rule}\u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        `;\n      } else if (r.is_tip_locked) {\n        tipHtml \u003d `\n          \u003cdiv class\u003d\"quick-tip-card locked\"\u003e\n            \u003cdiv class\u003d\"quick-tip-header\"\u003e\u003cspan\u003e⚡ MẸO 3S (ĐÃ KHÓA)\u003c/span\u003e\u003c/div\u003e\n            \u003cdiv class\u003d\"tip-lock-overlay\"\u003e\n              \u003cdiv class\u003d\"lock-title-text\"\u003e🔒 KHÓA MẸO TRẢ LỜI NHANH!\u003c/div\u003e\n              \u003cbutton class\u003d\"btn-lock-upgrade\" onclick\u003d\"app.showVipModal()\"\u003e👑 Nâng VIP (250k) Để Mở\u003c/button\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        `;\n      }\n\n      html +\u003d `\n        \u003cdiv class\u003d\"question-card\"\u003e\n          \u003cdiv class\u003d\"qcard-header\"\u003e\n            \u003cspan class\u003d\"q-badge-num\"\u003eCâu ${r.question_number}\u003c/span\u003e\n            \u003cspan class\u003d\"badge-tag ${r.is_correct ? \u0027bg-teal text-white\u0027 : \u0027bg-blue text-danger\u0027}\"\u003e\n              ${r.is_correct ? \u0027✅ Đúng\u0027 : \u0027❌ Sai\u0027}\n            \u003c/span\u003e\n          \u003c/div\u003e\n          \u003cdiv class\u003d\"q-text\"\u003e${r.question_text}\u003c/div\u003e\n          \u003cdiv class\u003d\"options-list\"\u003e${optionsHtml}\u003c/div\u003e\n          ${tipHtml}\n          \u003cdiv class\u003d\"explanation-box\"\u003e${r.explanation}\u003c/div\u003e\n        \u003c/div\u003e\n      `;\n    });\n\n    container.innerHTML \u003d html;\n    container.scrollIntoView({ behavior: \u0027smooth\u0027 });\n  },\n\n  // \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n  // 7. BIỂN BÁO GIAO THÔNG \u0026 MẸO TỔNG HỢP\n  // \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n  async loadTrafficSigns() {\n    const grid \u003d document.getElementById(\u0027trafficSignsGrid\u0027);\n    grid.innerHTML \u003d \u0027\u003cdiv class\u003d\"loading-spinner\"\u003eĐang tải danh mục biển báo...\u003c/div\u003e\u0027;\n    try {\n      const res \u003d await fetch(`/api/traffic-signs?category\u003d${this.state.activeSignCategory}`);\n      const data \u003d await res.json();\n      if (data.success) {\n        this.state.signs \u003d data.signs;\n        this.renderSigns(data.signs);\n      }\n    } catch (e) {\n      grid.innerHTML \u003d \u0027\u003cdiv class\u003d\"text-danger p-3 text-center\"\u003eKhông thể tải biển báo.\u003c/div\u003e\u0027;\n    }\n  },\n\n  renderSigns(signs) {\n    const grid \u003d document.getElementById(\u0027trafficSignsGrid\u0027);\n    if (!signs || signs.length \u003d\u003d\u003d 0) {\n      grid.innerHTML \u003d \u0027\u003cdiv class\u003d\"text-muted p-4 text-center\"\u003eKhông có biển báo phù hợp.\u003c/div\u003e\u0027;\n      return;\n    }\n\n    grid.innerHTML \u003d signs.map(s \u003d\u003e `\n      \u003cdiv class\u003d\"sign-card\"\u003e\n        \u003cdiv class\u003d\"sign-svg-wrap\"\u003e${s.image_svg}\u003c/div\u003e\n        \u003cspan class\u003d\"sign-code-tag\"\u003e${s.code}\u003c/span\u003e\n        \u003cdiv class\u003d\"sign-name-text\"\u003e${s.name}\u003c/div\u003e\n        \u003cp class\u003d\"sign-desc-text\"\u003e${s.description}\u003c/p\u003e\n      \u003c/div\u003e\n    `).join(\u0027\u0027);\n  },\n\n  filterSigns(category) {\n    this.state.activeSignCategory \u003d category;\n    document.querySelectorAll(\u0027.sign-tab-btn\u0027).forEach(btn \u003d\u003e {\n      btn.classList.toggle(\u0027active\u0027, btn.dataset.cat \u003d\u003d\u003d category);\n    });\n    this.loadTrafficSigns();\n  },\n\n  searchTrafficSigns(query) {\n    const q \u003d query.toLowerCase().trim();\n    if (!q) return this.renderSigns(this.state.signs);\n    const filtered \u003d this.state.signs.filter(s \u003d\u003e\n      s.code.toLowerCase().includes(q) || s.name.toLowerCase().includes(q) || s.description.toLowerCase().includes(q)\n    );\n    this.renderSigns(filtered);\n  },\n\n  async loadTheoryTips() {\n    const container \u003d document.getElementById(\u0027theoryTipsContainer\u0027);\n    container.innerHTML \u003d \u0027\u003cdiv class\u003d\"loading-spinner\"\u003eĐang tải bí kíp mẹo thi...\u003c/div\u003e\u0027;\n    try {\n      const res \u003d await fetch(\u0027/api/theory-tips\u0027);\n      const data \u003d await res.json();\n      if (data.success \u0026\u0026 data.tips) {\n        container.innerHTML \u003d data.tips.map(t \u003d\u003e `\n          \u003cdiv class\u003d\"theory-card\"\u003e\n            \u003ch3 class\u003d\"theory-card-title\"\u003e${t.title}\u003c/h3\u003e\n            \u003cdiv class\u003d\"theory-content\"\u003e${this.renderMarkdown(t.content_markdown)}\u003c/div\u003e\n          \u003c/div\u003e\n        `).join(\u0027\u0027);\n      }\n    } catch (e) {\n      container.innerHTML \u003d \u0027\u003cdiv class\u003d\"text-danger p-3 text-center\"\u003eKhông thể tải bí kíp.\u003c/div\u003e\u0027;\n    }\n  },\n\n  renderMarkdown(text) {\n    if (!text) return \u0027\u0027;\n    return text\n      .replace(/^### (.*$)/gim, \u0027\u003ch3\u003e$1\u003c/h3\u003e\u0027)\n      .replace(/\\*\\*(.*?)\\*\\*/g, \u0027\u003cstrong\u003e$1\u003c/strong\u003e\u0027)\n      .replace(/\\*(.*?)\\*/g, \u0027\u003cem\u003e$1\u003c/em\u003e\u0027)\n      .replace(/^- (.*$)/gim, \u0027\u003cli\u003e$1\u003c/li\u003e\u0027)\n      .replace(/\\n\\n/g, \u0027\u003cbr\u003e\u003cbr\u003e\u0027);\n  },\n\n  // \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n  // 8. THANH TOÁN VIETQR \u0026 GÓI VIP 250.000Đ\n  // \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n  async showVipModal() {\n    this.openModal(\u0027modalVipUpgrade\u0027);\n    try {\n      const headers \u003d {};\n      if (this.state.token) headers[\u0027Authorization\u0027] \u003d \u0027Bearer \u0027 + this.state.token;\n\n      const res \u003d await fetch(\u0027/api/payment/vietqr-info\u0027, { headers });\n      const data \u003d await res.json();\n\n      if (data.success \u0026\u0026 data.payment_info) {\n        const info \u003d data.payment_info;\n        document.getElementById(\u0027vietQrPriceDisplay\u0027).textContent \u003d info.formatted_price;\n        document.getElementById(\u0027vietQrBankName\u0027).textContent \u003d info.bank_name;\n        document.getElementById(\u0027vietQrAccountNo\u0027).textContent \u003d info.bank_account_no;\n        document.getElementById(\u0027vietQrAccountName\u0027).textContent \u003d info.bank_account_name;\n        document.getElementById(\u0027vietQrMemo\u0027).textContent \u003d info.transfer_memo;\n\n        // Render QR SVG\n        const qrBox \u003d document.getElementById(\u0027vietQrImageBox\u0027);\n        qrBox.innerHTML \u003d info.svg_qr_code;\n      }\n    } catch (e) {\n      console.warn(\u0027Lỗi tải thông tin VietQR:\u0027, e);\n    }\n  },\n\n  async confirmVipOrder() {\n    if (!this.state.user) {\n      this.closeModal(\u0027modalVipUpgrade\u0027);\n      this.toggleAuthModal();\n      this.showToast(\u0027Vui lòng đăng nhập để hệ thống ghi nhận đơn hàng VIP!\u0027, \u0027warning\u0027);\n      return;\n    }\n\n    try {\n      const res \u003d await fetch(\u0027/api/payment/create-order\u0027, {\n        method: \u0027POST\u0027,\n        headers: {\n          \u0027Content-Type\u0027: \u0027application/json\u0027,\n          \u0027Authorization\u0027: \u0027Bearer \u0027 + this.state.token\n        },\n        body: JSON.stringify({ order_type: \u0027VIP_UPGRADE\u0027 })\n      });\n      const data \u003d await res.json();\n      if (data.success) {\n        this.showToast(\u0027✅ Đã ghi nhận đơn chuyển khoản. Admin sẽ duyệt và kích hoạt VIP trong ít phút!\u0027, \u0027success\u0027);\n        this.closeModal(\u0027modalVipUpgrade\u0027);\n      }\n    } catch (e) {\n      this.showToast(\u0027Không thể tạo đơn hàng.\u0027, \u0027error\u0027);\n    }\n  },\n\n  // Kích hoạt mô phỏng thanh toán thành công (Test sandbox)\n  async simulateVipSuccess() {\n    if (!this.state.user) {\n      this.closeModal(\u0027modalVipUpgrade\u0027);\n      this.toggleAuthModal();\n      this.showToast(\u0027Vui lòng đăng nhập để nâng cấp VIP!\u0027, \u0027warning\u0027);\n      return;\n    }\n\n    try {\n      const res \u003d await fetch(\u0027/api/payment/simulate-confirm\u0027, {\n        method: \u0027POST\u0027,\n        headers: {\n          \u0027Content-Type\u0027: \u0027application/json\u0027,\n          \u0027Authorization\u0027: \u0027Bearer \u0027 + this.state.token\n        }\n      });\n      const data \u003d await res.json();\n      if (data.success) {\n        this.state.user \u003d data.user;\n        this.renderUserUI(data.user);\n        this.closeModal(\u0027modalVipUpgrade\u0027);\n        this.showToast(data.message, \u0027success\u0027);\n        if (this.state.currentTab \u003d\u003d\u003d \u0027practice\u0027) this.loadQuestions();\n      }\n    } catch (e) {\n      this.showToast(\u0027Lỗi kích hoạt mô phỏng\u0027, \u0027error\u0027);\n    }\n  },\n\n  async upgradeVipWithGold() {\n    if (!this.state.user) {\n      this.closeModal(\u0027modalVipUpgrade\u0027);\n      this.toggleAuthModal();\n      return;\n    }\n\n    try {\n      const res \u003d await fetch(\u0027/api/payment/upgrade-by-gold\u0027, {\n        method: \u0027POST\u0027,\n        headers: {\n          \u0027Content-Type\u0027: \u0027application/json\u0027,\n          \u0027Authorization\u0027: \u0027Bearer \u0027 + this.state.token\n        }\n      });\n      const data \u003d await res.json();\n      if (data.success) {\n        this.state.user \u003d data.user;\n        this.renderUserUI(data.user);\n        this.closeModal(\u0027modalVipUpgrade\u0027);\n        this.showToast(data.message, \u0027success\u0027);\n        if (this.state.currentTab \u003d\u003d\u003d \u0027practice\u0027) this.loadQuestions();\n      } else {\n        this.showToast(data.message, \u0027error\u0027);\n      }\n    } catch (e) {\n      this.showToast(\u0027Không thể thực hiện giao dịch Gold\u0027, \u0027error\u0027);\n    }\n  },\n\n  showDepositGoldModal() {\n    this.openModal(\u0027modalDepositGold\u0027);\n  },\n\n  selectGoldPack(amount) {\n    this.closeModal(\u0027modalDepositGold\u0027);\n    this.showVipModal();\n    this.showToast(`Bạn đã chọn gói nạp ${amount.toLocaleString()} đ`);\n  },\n\n  copyToClipboard(elementId, message) {\n    const text \u003d document.getElementById(elementId).textContent.trim();\n    navigator.clipboard.writeText(text).then(() \u003d\u003e {\n      this.showToast(message || \u0027Đã sao chép vào bộ nhớ tạm!\u0027, \u0027success\u0027);\n    }).catch(() \u003d\u003e {\n      this.showToast(\u0027Đã sao chép: \u0027 + text);\n    });\n  },\n\n  // \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u00