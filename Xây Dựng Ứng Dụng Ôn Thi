            "CodeContent": "// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n// DATABASE MANAGER: MẸO THI BẰNG N.SOWN\n// Sử dụng SQLite built-in node:sqlite trong Node.js 22\n// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\nconst { DatabaseSync } \u003d require(\u0027node:sqlite\u0027);\nconst fs \u003d require(\u0027node:fs\u0027);\nconst path \u003d require(\u0027node:path\u0027);\nconst crypto \u003d require(\u0027node:crypto\u0027);\nconst {\n  initialSettings,\n  initialQuestions,\n  initialTrafficSigns,\n  initialTheoryTips\n} \u003d require(\u0027./seed_data\u0027);\n\nconst DB_PATH \u003d path.join(__dirname, \u0027gplx_nsown.db\u0027);\nconst db \u003d new DatabaseSync(DB_PATH);\n\n// Bật WAL mode để tăng tốc truy vấn đọc/ghi song song\ndb.exec(\u0027PRAGMA journal_mode \u003d WAL;\u0027);\ndb.exec(\u0027PRAGMA foreign_keys \u003d ON;\u0027);\n\n// Hàm băm mật khẩu bảo mật (PBKDF2)\nfunction hashPassword(password) {\n  const salt \u003d crypto.randomBytes(16).toString(\u0027hex\u0027);\n  const hash \u003d crypto.pbkdf2Sync(password, salt, 1000, 64, \u0027sha512\u0027).toString(\u0027hex\u0027);\n  return `${salt}:${hash}`;\n}\n\nfunction verifyPassword(password, storedHash) {\n  if (!storedHash || !storedHash.includes(\u0027:\u0027)) return false;\n  const [salt, originalHash] \u003d storedHash.split(\u0027:\u0027);\n  const hashToVerify \u003d crypto.pbkdf2Sync(password, salt, 1000, 64, \u0027sha512\u0027).toString(\u0027hex\u0027);\n  return hashToVerify \u003d\u003d\u003d originalHash;\n}\n\n// Khởi tạo bảng và nạp dữ liệu ban đầu\nfunction initDatabase() {\n  const schemaSql \u003d fs.readFileSync(path.join(__dirname, \u0027schema.sql\u0027), \u0027utf-8\u0027);\n  db.exec(schemaSql);\n\n  // 1. Kiểm tra và khởi tạo Users mặc định\n  const userCount \u003d db.prepare(\u0027SELECT COUNT(*) AS count FROM users\u0027).get().count;\n  if (userCount \u003d\u003d\u003d 0) {\n    const insertUser \u003d db.prepare(`\n      INSERT INTO users (username, full_name, phone_or_email, password_hash, role, is_vip, gold_balance, status)\n      VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n    `);\n\n    // Tài khoản Quản Trị Viên (Admin)\n    insertUser.run(\n      \u0027admin\u0027,\n      \u0027Quản Trị Viên N.Sown\u0027,\n      \u0027admin@nsown.vn\u0027,\n      hashPassword(\u0027admin123\u0027),\n      \u0027admin\u0027,\n      1,\n      999999,\n      \u0027active\u0027\n    );\n\n    // Tài khoản Thường (Free Demo) - Dùng thử mẹo 3 câu đầu\n    insertUser.run(\n      \u0027userdemo\u0027,\n      \u0027Nguyễn Văn Học Viên (Thường)\u0027,\n      \u0027user@nsown.vn\u0027,\n      hashPassword(\u0027user123\u0027),\n      \u0027user\u0027,\n      0,\n      20000,\n      \u0027active\u0027\n    );\n\n    // Tài khoản VIP Demo - Xem full 100% mẹo\n    insertUser.run(\n      \u0027vipdemo\u0027,\n      \u0027Trần Thị Đỗ Bằng (VIP)\u0027,\n      \u0027vip@nsown.vn\u0027,\n      hashPassword(\u0027vip123\u0027),\n      \u0027user\u0027,\n      1,\n      150000,\n      \u0027active\u0027\n    );\n\n    console.log(\u0027[DB] Khởi tạo 3 tài khoản mẫu thành công: Admin, User Thường, User VIP.\u0027);\n  }\n\n  // 2. Cài đặt hệ thống (System Settings)\n  const insertSetting \u003d db.prepare(`\n    INSERT OR IGNORE INTO system_settings (key, value, description)\n    VALUES (?, ?, ?)\n  `);\n  for (const s of initialSettings) {\n    insertSetting.run(s.key, s.value, s.description);\n  }\n\n  // 3. Câu hỏi và Mẹo 3 Giây\n  const questionCount \u003d db.prepare(\u0027SELECT COUNT(*) AS count FROM questions\u0027).get().count;\n  if (questionCount \u003d\u003d\u003d 0) {\n    const insertQuestion \u003d db.prepare(`\n      INSERT INTO questions (id, license_tiers, category, question_text, image_url, options, correct_option_index, explanation, is_critical, order_index)\n      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n    `);\n\n    const insertTip \u003d db.prepare(`\n      INSERT INTO quick_tips (question_id, tip_title, tip_keyword, tip_rule, tip_mnemonic, speed_seconds)\n      VALUES (?, ?, ?, ?, ?, ?)\n    `);\n\n    for (const q of initialQuestions) {\n      insertQuestion.run(\n        q.id,\n        q.license_tiers,\n        q.category,\n        q.question_text,\n        q.image_url,\n        q.options,\n        q.correct_option_index,\n        q.explanation,\n        q.is_critical,\n        q.order_index\n      );\n\n      if (q.quick_tip) {\n        insertTip.run(\n          q.id,\n          q.quick_tip.tip_title,\n          q.quick_tip.tip_keyword,\n          q.quick_tip.tip_rule,\n          q.quick_tip.tip_mnemonic,\n          q.quick_tip.speed_seconds || 3\n        );\n      }\n    }\n    console.log(`[DB] Đã nạp ${initialQuestions.length} câu hỏi kèm Mẹo 3s siêu tốc.`);\n  }\n\n  // 4. Biển báo giao thông\n  const signCount \u003d db.prepare(\u0027SELECT COUNT(*) AS count FROM traffic_signs\u0027).get().count;\n  if (signCount \u003d\u003d\u003d 0) {\n    const insertSign \u003d db.prepare(`\n      INSERT INTO traffic_signs (code, name, category, image_svg, description)\n      VALUES (?, ?, ?, ?, ?)\n    `);\n    for (const s of initialTrafficSigns) {\n      insertSign.run(s.code, s.name, s.category, s.image_svg, s.description);\n    }\n    console.log(`[DB] Đã nạp ${initialTrafficSigns.length} biển báo giao thông chuẩn.`);\n  }\n\n  // 5. Mẹo thi tổng hợp\n  const tipCount \u003d db.prepare(\u0027SELECT COUNT(*) AS count FROM theory_tips\u0027).get().count;\n  if (tipCount \u003d\u003d\u003d 0) {\n    const insertTheoryTip \u003d db.prepare(`\n      INSERT INTO theory_tips (category, title, content_markdown, order_index)\n      VALUES (?, ?, ?, ?)\n    `);\n    for (const t of initialTheoryTips) {\n      insertTheoryTip.run(t.category, t.title, t.content_markdown, t.order_index);\n    }\n    console.log(`[DB] Đã nạp ${initialTheoryTips.length} chuyên đề mẹo thi tổng hợp.`);\n  }\n\n  // 6. Ghi nhận lượt truy cập khởi đầu\n  db.prepare(`\n    INSERT INTO site_analytics (visited_at, path, ip, user_agent)\n    VALUES (CURRENT_DATE, \u0027/\u0027, \u0027127.0.0.1\u0027, \u0027System Init\u0027)\n  `).run();\n}\n\nmodule.exports \u003d {\n  db,\n  initDatabase,\n  hashPassword,\n  verifyPassword\n};\n",
