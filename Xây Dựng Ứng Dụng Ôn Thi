 border: none;\n  cursor: pointer;\n  transition: all 0.15s;\n}\n\n.btn-primary {\n  background-color: var(--primary-blue);\n  color: #ffffff;\n}\n.btn-primary:hover { background-color: var(--primary-dark); }\n\n.btn-warning {\n  background-color: var(--color-gold);\n  color: #000000;\n}\n.btn-warning:hover { background-color: var(--color-gold-dark); color: #fff; }\n\n.btn-danger {\n  background-color: var(--color-danger);\n  color: #ffffff;\n}\n\n.btn-success {\n  background-color: var(--color-success);\n  color: #ffffff;\n}\n\n.btn-gold {\n  background: linear-gradient(135deg, #ffd700 0%, #f59e0b 100%);\n  color: #854d0e;\n}\n\n.btn-outline {\n  background-color: transparent;\n  border: 1.5px solid var(--border-color);\n  color: var(--color-text-main);\n}\n.btn-outline:hover { background-color: #f1f5f9; }\n\n.btn-sm { padding: 4px 10px; font-size: 0.75rem; }\n.btn-lg { padding: 12px 20px; font-size: 0.95rem; }\n.btn-block { width: 100%; }\n\n.form-group {\n  margin-bottom: 12px;\n}\n\n.form-row {\n  display: flex;\n  gap: 10px;\n}\n\n.col-4 { flex: 1; }\n.col-6 { flex: 1; }\n\n.form-label {\n  display: block;\n  font-size: 0.78rem;\n  font-weight: 700;\n  color: #334155;\n  margin-bottom: 4px;\n}\n\n.form-control {\n  width: 100%;\n  padding: 8px 12px;\n  border: 1.5px solid var(--border-color);\n  border-radius: var(--radius-sm);\n  font-size: 0.82rem;\n  font-family: inherit;\n  background: #ffffff;\n}\n\n.form-control:focus {\n  outline: none;\n  border-color: var(--primary-blue);\n}\n\n.form-hint {\n  display: block;\n  font-size: 0.7rem;\n  color: var(--color-text-muted);\n  margin-top: 3px;\n}\n\n/* ---------------- MODALS \u0026 POPUPS ---------------- */\n.modal-backdrop {\n  position: fixed;\n  inset: 0;\n  background: rgba(15, 23, 42, 0.65);\n  backdrop-filter: blur(4px);\n  z-index: 100;\n  display: none;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n  animation: fadeIn 0.15s ease;\n}\n\n.modal-backdrop.show {\n  display: flex;\