" width\u003d\"20\" height\u003d\"10\" /\u003e\n      \u003crect x\u003d\"125\" y\u003d\"150\" width\u003d\"15\" height\u003d\"25\" /\u003e\n      \u003crect x\u003d\"150\" y\u003d\"155\" width\u003d\"25\" height\u003d\"10\" /\u003e\n      \u003crect x\u003d\"185\" y\u003d\"155\" width\u003d\"15\" height\u003d\"15\" /\u003e\n      \u003crect x\u003d\"75\" y\u003d\"180\" width\u003d\"25\" height\u003d\"15\" /\u003e\n      \u003crect x\u003d\"110\" y\u003d\"185\" width\u003d\"30\" height\u003d\"15\" /\u003e\n      \u003crect x\u003d\"150\" y\u003d\"180\" width\u003d\"15\" height\u003d\"20\" /\u003e\n      \u003crect x\u003d\"175\" y\u003d\"180\" width\u003d\"25\" height\u003d\"10\" /\u003e\n    \u003c/g\u003e\n    \u003c!-- Logo VietQR ở giữa --\u003e\n    \u003crect x\u003d\"85\" y\u003d\"85\" width\u003d\"50\" height\u003d\"50\" rx\u003d\"8\" fill\u003d\"#ffffff\" stroke\u003d\"#1565c0\" stroke-width\u003d\"2\"/\u003e\n    \u003ctext x\u003d\"110\" y\u003d\"108\" font-size\u003d\"11\" font-weight\u003d\"900\" fill\u003d\"#0d47a1\" text-anchor\u003d\"middle\" font-family\u003d\"sans-serif\"\u003eVietQR\u003c/text\u003e\n    \u003ctext x\u003d\"110\" y\u003d\"122\" font-size\u003d\"8\" font-weight\u003d\"700\" fill\u003d\"#e53935\" text-anchor\u003d\"middle\" font-family\u003d\"sans-serif\"\u003eN.SOWN\u003c/text\u003e\n  \u003c/svg\u003e`;\n}\n\n// Khởi tạo máy chủ HTTP\nconst server \u003d http.createServer(async (req, res) \u003d\u003e {\n  const parsedUrl \u003d url.parse(req.url, true);\n  const pathname \u003d parsedUrl.pathname;\n  const method \u003d req.method;\n\n  // Bắt CORS preflight\n  if (method \u003d\u003d\u003d \u0027OPTIONS\u0027) {\n    res.writeHead(204, {\n      \u0027Access-Control-Allow-Origin\u0027: \u0027*\u0027,\n      \u0027Access-Control-Allow-Headers\u0027: \u0027Content-Type, Authorization\u0027,\n      \u0027Access-Control-Allow-Methods\u0027: \u0027GET, POST, PUT, DELETE, OPTIONS\u0027\n    });\n    return res.end();\n  }\n\n  // Ghi nhận traffic analytics\n  const clientIp \u003d req.headers[\u0027x-forwarded-for\u0027] || req.socket.remoteAddress || \u0027127.0.0.1\u0027;\n  onlineUsers.set(clientIp, Date.now());\n  // Dọn dẹp user online sau 10 phút\n  const now \u003d Date.now();\n  for (const [key, ts] of onlineUsers.entries()) {\n    if (now - ts \u003e 10 * 60 * 1000) onlineUsers.delete(key);\n  }\n\n  // Tăng lượt truy cập định kỳ\n  if (pathname \u003d\u003d\u003d \u0027/\u0027 || pathname \u003d\u003d\u003d \u0027/index.html\u0027) {\n    try {\n      db.prepare(`\n        INSERT INTO site_analytics (visited_at, path, ip, user_agent)\n        VALUES (CURRENT_DATE, ?, ?, ?)\n      `).run(pathname, clientIp, req.headers[\u0027user-agent\u0027] || \u0027\u0027);\n    } catch (e) {}\n  }\n\n  // -------------------------------------------------------------\n  // API ROUTING\n  // -------------------------------------------------------------\n  try {\n    // 1. CẤU HÌNH HỆ THỐNG CÔNG KHAI\n    if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/settings\u0027) {\n      const rows \u003d db.prepare(\u0027SELECT key, value FROM system_settings\u0027).all();\n      const settings \u003d {};\n      rows.forEach(r \u003d\u003e { settings[r.key] \u003d r.value; });\n      return sendJson(res, 200, { success: true, settings });\n    }\n\n    // 2. AUTHENTICATION \u0026 USER PROFILE\n    if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/auth/register\u0027) {\n      const body \u003d await parseJsonBody(req);\n      const { full_name, phone_or_email, password } \u003d body;\n      if (!full_name || !phone_or_email || !password) {\n        return sendJson(res, 400, { success: false, message: \u0027Vui lòng điền đầy đủ họ tên, SĐT/Email và mật khẩu!\u0027 });\n      }\n\n      // Kiểm tra trùng\n      const existing \u003d db.prepare(\u0027SELECT id FROM users WHERE phone_or_email \u003d ?\u0027).get(phone_or_email);\n      if (existing) {\n        return sendJson(res, 400, { success: false, message: \u0027Số điện thoại hoặc Email này đã được đăng ký!\u0027 });\n      }\n\n      const username \u003d phone_or_email.split(\u0027@\u0027)[0].replace(/[^a-zA-Z0-9]/g, \u0027\u0027) + Math.floor(Math.random() * 1000);\n      const insert \u003d db.prepare(`\n        INSERT INTO users (username, full_name, phone_or_email, password_hash, role, is_vip, gold_balance, status)\n        VALUES (?, ?, ?, ?, \u0027user\u0027, 0, 10000, \u0027active\u0027)\n      `);\n      const info \u003d insert.run(username, full_name, phone_or_email, hashPassword(password));\n      const user \u003d db.prepare(\u0027SELECT id, username, full_name, phone_or_email, role, is_vip, gold_balance, status FROM users WHERE id \u003d ?\u0027).get(info.lastInsertRowid);\n      const token \u003d generateToken(user);\n\n      return sendJson(res, 201, {\n        success: true,\n        message: \u0027Đăng ký tài khoản thành công! Tặng ngay 10.000 Gold chào mừng.\u0027,\n        token,\n        user\n      });\n    }\n\n    if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/auth/login\u0027) {\n      const body \u003d await parseJsonBody(req);\n      const { phone_or_email, password } \u003d body;\n      if (!phone_or_email || !password) {\n        return sendJson(res, 400, { success: false, message: \u0027Vui lòng nhập tài khoản và mật khẩu!\u0027 });\n      }\n\n      const user \u003d db.prepare(\u0027SELECT * FROM users WHERE phone_or_email \u003d ? OR username \u003d ?\u0027).get(phone_or_email, phone_or_email);\n      if (!user) {\n        return sendJson(res, 401, { success: false, message: \u0027Tài khoản không tồn tại trong hệ thống!\u0027 });\n      }\n\n      if (user.status \u003d\u003d\u003d \u0027locked\u0027) {\n        return sendJson(res, 403, { success: false, message: \u0027Tài khoản của bạn đã bị khóa bởi Quản trị viên!\u0027 });\n      }\n\n      if (!verifyPassword(password, user.password_hash)) {\n        return sendJson(res, 401, { success: false, message: \u0027Mật khẩu không chính xác!\u0027 });\n      }\n\n      const safeUser \u003d {\n        id: user.id,\n        username: user.username,\n        full_name: user.full_name,\n        phone_or_email: user.phone_or_email,\n        role: user.role,\n        is_vip: user.is_vip,\n        gold_balance: user.gold_balance,\n        status: user.status\n      };\n      const token \u003d generateToken(safeUser);\n\n      return sendJson(res, 200, {\n        success: true,\n        message: \u0027Đăng nhập thành công!\u0027,\n        token,\n        user: safeUser\n      });\n    }\n\n    if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/auth/me\u0027) {\n      const user \u003d getAuthUser(req);\n      if (!user) {\n        return sendJson(res, 401, { success: false, message: \u0027Chưa đăng nhập hoặc phiên làm việc đã hết hạn\u0027 });\n      }\n      return sendJson(res, 200, { success: true, user });\n    }\n\n    // 3. DANH SÁCH CÂU HỎI \u0026 MẸO 3 GIÂY (ÁP DỤNG PHÂN QUYỀN VIP / FREE)\n    if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/questions\u0027) {\n      const user \u003d getAuthUser(req);\n      const isVip \u003d user \u0026\u0026 user.is_vip \u003d\u003d\u003d 1;\n\n      // Lấy giới hạn câu miễn phí từ system_settings\n      const limitSetting \u003d db.prepare(\"SELECT value FROM system_settings WHERE key \u003d \u0027free_tip_question_limit\u0027\").get();\n      const freeTipLimit \u003d parseInt(limitSetting ? limitSetting.value : \u00273\u0027, 10);\n\n      const category \u003d parsedUrl.query.category;\n      const tier \u003d parsedUrl.query.tier;\n      const isCritical \u003d parsedUrl.query.critical;\n      const search \u003d parsedUrl.query.search;\n\n      let sql \u003d `\n        SELECT q.id, q.license_tiers, q.category, q.question_text, q.image_url,\n               q.options, q.correct_option_index, q.explanation, q.is_critical, q.order_index,\n               t.tip_title, t.tip_keyword, t.tip_rule, t.tip_mnemonic, t.speed_seconds\n        FROM questions q\n        LEFT JOIN quick_tips t ON q.id \u003d t.question_id\n        WHERE 1\u003d1\n      `;\n      const params \u003d [];\n\n      if (category \u0026\u0026 category !\u003d\u003d \u0027all\u0027) {\n        sql +\u003d \u0027 AND q.category \u003d ?\u0027;\n        params.push(category);\n      }\n      if (isCritical \u003d\u003d\u003d \u00271\u0027) {\n        sql +\u003d \u0027 AND q.is_critical \u003d 1\u0027;\n      }\n      if (search) {\n        sql +\u003d \u0027 AND (q.question_text LIKE ? OR t.tip_keyword LIKE ?)\u0027;\n        params.push(`%${search}%`, `%${search}%`);\n      }\n\n      sql +\u003d \u0027 ORDER BY q.order_index ASC, q.id ASC\u0027;\n\n      const rawQuestions \u003d db.prepare(sql).all(...params);\n\n      // Xử lý lọc theo Hạng GPLX (nếu có)\n      let filtered \u003d rawQuestions;\n      if (tier \u0026\u0026 tier !\u003d\u003d \u0027ALL\u0027) {\n        filtered \u003d rawQuestions.filter(q \u003d\u003e {\n          try {\n            const tiers \u003d JSON.parse(q.license_tiers);\n            return tiers.includes(tier) || tiers.includes(\u0027ALL\u0027);\n          } catch (e) {\n            return true;\n          }\n        });\n      }\n\n      // Xử lý phân quyền Mẹo trả lời nhanh:\n      // Tài khoản Free: Chỉ xem Mẹo của 3 CÂU ĐẦU TIÊN (index 0, 1, 2)\n      // Từ câu thứ 4 trở đi (index \u003e\u003d 3): Khóa Mẹo và trả cờ is_tip_locked: true\n      const questionsWithTipControl \u003d filtered.map((q, index) \u003d\u003e {\n        const parsedOptions \u003d JSON.parse(q.options);\n        const questionNumber \u003d index + 1;\n        const canViewTip \u003d isVip || index \u003c freeTipLimit;\n\n        if (canViewTip) {\n          return {\n            id: q.id,\n            question_number: questionNumber,\n            category: q.category,\n            question_text: q.question_text,\n            image_url: q.image_url,\n            options: parsedOptions,\n            correct_option_index: q.correct_option_index,\n            explanation: q.explanation,\n            is_critical: q.is_critical,\n            is_tip_locked: false,\n            quick_tip: q.tip_title ? {\n              title: q.tip_title,\n              keyword: q.tip_keyword,\n              rule: q.tip_rule,\n              mnemonic: q.tip_mnemonic,\n              speed_seconds: q.speed_seconds || 3\n            } : null\n          };\n        } else {\n          // Bị khóa Mẹo đối với người dùng Miễn phí từ câu thứ 4 trở đi\n          return {\n            id: q.id,\n            question_number: questionNumber,\n            category: q.category,\n            question_text: q.question_text,\n            image_url: q.image_url,\n            options: parsedOptions,\n            correct_option_index: q.correct_option_index,\n            explanation: q.explanation,\n            is_critical: q.is_critical,\n            is_tip_locked: true,\n            lock_message: \u0027🔒 Khóa Mẹo Trả Lời Nhanh! Nâng cấp gói VIP (250.000đ) để xem full 100% mẹo khoanh siêu tốc bao đậu.\u0027,\n            quick_tip: {\n              title: \u0027⚡ Mẹo trả lời nhanh câu này (Đã khóa)\u0027,\n              keyword: \u0027*** TỪ KHÓA BỊ KHÓA ***\u0027,\n              rule: \u0027Bạn đang dùng tài khoản Thường (chỉ xem được 3 câu đầu). Nâng cấp VIP 250.000đ để mở khóa mẹo khoanh 3 giây cho toàn bộ câu hỏi!\u0027,\n              mnemonic: \u0027Bí kíp độc quyền N.Sown mở khóa khi lên VIP.\u0027,\n              speed_seconds: 3\n            }\n          };\n        }\n      });\n\n      return sendJson(res, 200, {\n        success: true,\n        user_is_vip: isVip,\n        free_tip_limit: freeTipLimit,\n        total: questionsWithTipControl.length,\n        questions: questionsWithTipControl\n      });\n    }\n\n    // 4. THI THỬ CHUẨN BỘ GIAO THÔNG VẬN TẢI (MÔ PHỎNG ĐỀ THI \u0026 TÍNH ĐIỂM)\n    if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/exams/generate\u0027) {\n      const tier \u003d (parsedUrl.query.tier || \u0027A1\u0027).toUpperCase();\n      \n      // Quy chuẩn Bộ GTVT về số câu \u0026 thời gian\n      const examConfigs \u003d {\n        \u0027A1\u0027: { total: 25, pass_score: 21, time_minutes: 19, critical_count: 2 },\n        \u0027A2\u0027: { total: 25, pass_score: 23, time_minutes: 19, critical_count: 2 },\n        \u0027B1\u0027: { total: 30, pass_score: 26, time_minutes: 20, critical_count: 3 },\n        \u0027B2\u0027: { total: 35, pass_score: 32, time_minutes: 22, critical_count: 3 },\n        \u0027C\u0027:  { total: 40, pass_score: 36, time_minutes: 24, critical_count: 4 }\n      };\n\n      const config \u003d examConfigs[tier] || examConfigs[\u0027A1\u0027];\n\n      // Lấy câu hỏi trong DB\n      const allTierQuestions \u003d db.prepare(`\n        SELECT q.id, q.category, q.question_text, q.image_url, q.options, q.correct_option_index, q.explanation, q.is_critical,\n               t.tip_title, t.tip_keyword, t.tip_rule, t.tip_mnemonic, t.speed_seconds\n        FROM questions q\n        LEFT JOIN quick_tips t ON q.id \u003d t.question_id\n      `).all();\n\n      // Phân loại thường và điểm liệt\n      const criticalList \u003d allTierQuestions.filter(q \u003d\u003e q.is_critical \u003d\u003d\u003d 1);\n      const regularList \u003d allTierQuestions.filter(q \u003d\u003e q.is_critical \u003d\u003d\u003d 0);\n\n      // Trộn ngẫu nhiên câu hỏi\n      const shuffle \u003d arr \u003d\u003e [...arr].sort(() \u003d\u003e 0.5 - Math.random());\n      const selectedCritical \u003d shuffle(criticalList).slice(0, config.critical_count);\n      const remainingCount \u003d config.total - selectedCritical.length;\n      const selectedRegular \u003d shuffle(regularList).slice(0, remainingCount);\n\n      const combinedQuestions \u003d shuffle([...selectedCritical, ...selectedRegular]).map((q, idx) \u003d\u003e ({\n        exam_index: idx + 1,\n        id: q.id,\n        category: q.category,\n        question_text: q.question_text,\n        image_url: q.image_url,\n        options: JSON.parse(q.options),\n        is_critical: q.is_critical\n        // Giấu correct_option_index \u0026 quick_tip cho tới khi nộp bài\n      }));\n\n      return sendJson(res, 200, {\n        success: true,\n        exam: {\n          license_tier: tier,\n          config,\n          questions: combinedQuestions\n        }\n      });\n    }\n\n    if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/exams/submit\u0027) {\n      const user \u003d getAuthUser(req);\n      const body \u003d await parseJsonBody(req);\n      const { license_tier, answers, time_spent_seconds } \u003d body;\n      // answers: [{ question_id: 1, selected_option_index: 1 }, ...]\n\n      if (!answers || !Array.isArray(answers)) {\n        return sendJson(res, 400, { success: false, message: \u0027Dữ liệu bài thi không hợp lệ!\u0027 });\n      }\n\n      const isVip \u003d user \u0026\u0026 user.is_vip \u003d\u003d\u003d 1;\n      const limitSetting \u003d db.prepare(\"SELECT value FROM system_settings WHERE key \u003d \u0027free_tip_question_limit\u0027\").get();\n      const freeTipLimit \u003d parseInt(limitSetting ? limitSetting.value : \u00273\u0027, 10);\n\n      const examConfigs \u003d {\n        \u0027A1\u0027: { total: 25, pass_score: 21 },\n        \u0027A2\u0027: { total: 25, pass_score: 23 },\n        \u0027B1\u0027: { total: 30, pass_score: 26 },\n        \u0027B2\u0027: { total: 35, pass_score: 32 },\n        \u0027C\u0027:  { total: 40, pass_score: 36 }\n      };\n      const tierConfig \u003d examConfigs[license_tier] || examConfigs[\u0027A1\u0027];\n\n      let correctCount \u003d 0;\n      let failedByCritical \u003d false;\n      const detailedResults \u003d [];\n\n      answers.forEach((ans, idx) \u003d\u003e {\n        const q \u003d db.prepare(`\n          SELECT q.*, t.tip_title, t.tip_keyword, t.tip_rule, t.tip_mnemonic, t.speed_seconds\n          FROM questions q\n          LEFT JOIN quick_tips t ON q.id \u003d t.question_id\n          WHERE q.id \u003d ?\n        `).get(ans.question_id);\n\n        if (!q) return;\n\n        const isCorrect \u003d ans.selected_option_index \u003d\u003d\u003d q.correct_option_index;\n        if (isCorrect) {\n          correctCount++;\n        } else if (q.is_critical \u003d\u003d\u003d 1) {\n          // Sai câu điểm liệt!\n          failedByCritical \u003d true;\n        }\n\n        const canViewTip \u003d isVip || idx \u003c freeTipLimit;\n\n        detailedResults.push({\n          question_id: q.id,\n          question_number: idx + 1,\n          question_text: q.question_text,\n          image_url: q.image_url,\n          options: JSON.parse(q.options),\n          user_selected_index: ans.selected_option_index,\n          correct_option_index: q.correct_option_index,\n          is_correct: isCorrect,\n          is_critical: q.is_critical,\n          explanation: q.explanation,\n          is_tip_locked: !canViewTip,\n          quick_tip: canViewTip ? {\n            title: q.tip_title,\n            keyword: q.tip_keyword,\n            rule: q.tip_rule,\n            mnemonic: q.tip_mnemonic,\n            speed_seconds: q.speed_seconds || 3\n          } : null\n        });\n      });\n\n      const totalQuestions \u003d detailedResults.length;\n      // Điều kiện đạt: Điểm \u003e\u003d pass_score VÀ KHÔNG sai câu điểm liệt\n      const isPassed \u003d correctCount \u003e\u003d tierConfig.pass_score \u0026\u0026 !failedByCritical;\n\n      // Lưu kết quả thi vào bảng exam_records nếu user đã đăng nhập\n      if (user) {\n        db.prepare(`\n          INSERT INTO exam_records (user_id, license_tier, total_questions, correct_count, score, is_passed, failed_by_critical, time_spent_seconds, user_answers)\n          VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n        `).run(\n          user.id,\n          license_tier,\n          totalQuestions,\n          correctCount,\n          correctCount,\n          isPassed ? 1 : 0,\n          failedByCritical ? 1 : 0,\n          time_spent_seconds || 0,\n          JSON.stringify(answers)\n        );\n      }\n\n      return sendJson(res, 200, {\n        success: true,\n        summary: {\n          license_tier,\n          total_questions: totalQuestions,\n          correct_count: correctCount,\n          pass_threshold: tierConfig.pass_score,\n          is_passed: isPassed,\n          failed_by_critical: failedByCritical,\n          result_text: isPassed ? \u0027🎉 CHÚC MỪNG: BẠN ĐÃ THI ĐẠT!\u0027 : (failedByCritical ? \u0027❌ KHÔNG ĐẠT: Bạn đã trả lời sai câu điểm liệt!\u0027 : \u0027❌ KHÔNG ĐẠT: Chưa đủ điểm qua bài thi.\u0027),\n          time_spent_seconds: time_spent_seconds || 0\n        },\n        review: detailedResults\n      });\n    }\n\n    // 5. BIỂN BÁO GIAO THÔNG \u0026 MẸO TỔNG HỢP\n    if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/traffic-signs\u0027) {\n      const category \u003d parsedUrl.query.category;\n      let sql \u003d \u0027SELECT * FROM traffic_signs WHERE 1\u003d1\u0027;\n      const params \u003d [];\n      if (category \u0026\u0026 category !\u003d\u003d \u0027all\u0027) {\n        sql +\u003d \u0027 AND category \u003d ?\u0027;\n        params.push(category);\n      }\n      sql +\u003d \u0027 ORDER BY id ASC\u0027;\n      const signs \u003d db.prepare(sql).all(...params);\n      return sendJson(res, 200, { success: true, signs });\n    }\n\n    if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/theory-tips\u0027) {\n      const tips \u003d db.prepare(\u0027SELECT * FROM theory_tips ORDER BY order_index ASC\u0027).all();\n      return sendJson(res, 200, { success: true, tips });\n    }\n\n    // 6. THANH TOÁN VIETQR \u0026 GÓI VIP 250.000Đ\n    if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/payment/vietqr-info\u0027) {\n      const user \u003d getAuthUser(req);\n      const settingsRows \u003d db.prepare(\u0027SELECT key, value FROM system_settings\u0027).all();\n      const settings \u003d {};\n      settingsRows.forEach(r \u003d\u003e { settings[r.key] \u003d r.value; });\n\n      const vipPrice \u003d parseInt(settings.vip_price || \u0027250000\u0027, 10);\n      const bankBin \u003d settings.bank_bin || \u0027970422\u0027;\n      const bankAccountNo \u003d settings.bank_account_no || \u00270988889999\u0027;\n      const bankAccountName \u003d settings.bank_account_name || \u0027NGUYEN SON - N.SOWN\u0027;\n      const userRefCode \u003d user ? `VIP ${user.id} NSOWN` : `VIP ${Math.floor(1000 + Math.random() * 9000)} NSOWN`;\n\n      // Tạo link VietQR chuẩn\n      const encodedAccountName \u003d encodeURIComponent(bankAccountName);\n      const encodedMemo \u003d encodeURIComponent(userRefCode);\n      const vietQrUrl \u003d `https://img.vietqr.io/image/${bankBin}-${bankAccountNo}-compact2.png?amount\u003d${vipPrice}\u0026addInfo\u003d${encodedMemo}\u0026accountName\u003d${encodedAccountName}`;\n      const svgQrCode \u003d generateSvgQrCode(userRefCode);\n\n      return sendJson(res, 200, {\n        success: true,\n        payment_info: {\n          vip_price: vipPrice,\n          formatted_price: vipPrice.toLocaleString(\u0027vi-VN\u0027) + \u0027 đ\u0027,\n          bank_name: settings.bank_name || \u0027MBBank\u0027,\n          bank_bin: bankBin,\n          bank_account_no: bankAccountNo,\n          bank_account_name: bankAccountName,\n          transfer_memo: userRefCode,\n          vietqr_url: vietQrUrl,\n          svg_qr_code: svgQrCode\n        }\n      });\n    }\n\n    // Tạo đơn hàng mua VIP / nạp Gold\n    if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/payment/create-order\u0027) {\n      const user \u003d getAuthUser(req);\n      if (!user) {\n        return sendJson(res, 401, { success: false, message: \u0027Vui lòng đăng nhập để nâng cấp VIP\u0027 });\n      }\n\n      const body \u003d await parseJsonBody(req);\n      const orderType \u003d body.order_type || \u0027VIP_UPGRADE\u0027;\n      const settings \u003d db.prepare(\"SELECT value FROM system_settings WHERE key \u003d \u0027vip_price\u0027\").get();\n      const amount \u003d orderType \u003d\u003d\u003d \u0027VIP_UPGRADE\u0027 ? parseInt(settings.value || \u0027250000\u0027, 10) : (body.amount || 50000);\n      const orderCode \u003d \u0027ORD\u0027 + Date.now().toString().slice(-8) + user.id;\n      const transferContent \u003d `NSOWN VIP ${user.id} ${orderCode.slice(-4)}`;\n\n      db.prepare(`\n        INSERT INTO orders (order_code, user_id, order_type, amount, gold_amount, payment_method, status, transfer_content, note)\n        VALUES (?, ?, ?, ?, ?, \u0027VIETQR\u0027, \u0027PENDING\u0027, ?, ?)\n      `).run(\n        orderCode,\n        user.id,\n        orderType,\n        amount,\n        orderType \u003d\u003d\u003d \u0027GOLD_DEPOSIT\u0027 ? amount : 0,\n        transferContent,\n        body.note || \u0027Yêu cầu nâng cấp gói VIP 250k\u0027\n      );\n\n      return sendJson(res, 201, {\n        success: true,\n        message: \u0027Tạo đơn hàng thành công! Vui lòng chuyển khoản theo thông tin VietQR.\u0027,\n        order: {\n          order_code: orderCode,\n          amount,\n          transfer_content: transferContent,\n          status: \u0027PENDING\u0027\n        }\n      });\n    }\n\n    // Mô phỏng thanh toán thành công ngay lập tức (Test Sandbox / Tự động kích hoạt)\n    if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/payment/simulate-confirm\u0027) {\n      const user \u003d getAuthUser(req);\n      if (!user) {\n        return sendJson(res, 401, { success: false, message: \u0027Vui lòng đăng nhập!\u0027 });\n      }\n\n      // Kích hoạt VIP ngay lập tức cho User\n      db.prepare(\u0027UPDATE users SET is_vip \u003d 1, updated_at \u003d CURRENT_TIMESTAMP WHERE id \u003d ?\u0027).run(user.id);\n\n      // Tạo đơn hàng trạng thái COMPLETED\n      const orderCode \u003d \u0027SIM\u0027 + Date.now().toString().slice(-8);\n      db.prepare(`\n        INSERT INTO orders (order_code, user_id, order_type, amount, payment_method, status, transfer_content, note)\n        VALUES (?, ?, \u0027VIP_UPGRADE\u0027, 250000, \u0027VIETQR\u0027, \u0027COMPLETED\u0027, ?, \u0027Thanh toán mô phỏng thành công tức thì\u0027)\n      `).run(orderCode, user.id, `VIP ${user.id} NSOWN`);\n\n      const updatedUser \u003d db.prepare(\u0027SELECT id, username, full_name, phone_or_email, role, is_vip, gold_balance, status FROM users WHERE id \u003d ?\u0027).get(user.id);\n\n      return sendJson(res, 200, {\n        success: true,\n        message: \u0027🎉 Chúc mừng bạn đã nâng cấp VIP thành công! Toàn bộ 100% Mẹo 3s đã được mở khóa.\u0027,\n        user: updatedUser\n      });\n    }\n\n    // Nâng cấp VIP bằng số dư Gold trong tài khoản\n    if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/payment/upgrade-by-gold\u0027) {\n      const user \u003d getAuthUser(req);\n      if (!user) return sendJson(res, 401, { success: false, message: \u0027Vui lòng đăng nhập!\u0027 });\n\n      const VIP_GOLD_COST \u003d 250000;\n      if (user.gold_balance \u003c VIP_GOLD_COST) {\n        return sendJson(res, 400, {\n          success: false,\n          message: `Số dư Gold không đủ (Hiện có: ${user.gold_balance.toLocaleString()} Gold, cần: ${VIP_GOLD_COST.toLocaleString()} Gold). Vui lòng nạp thêm Gold hoặc quét mã VietQR!`\n        });\n      }\n\n      // Trừ Gold và cấp VIP\n      db.prepare(\u0027UPDATE users SET gold_balance \u003d gold_balance - ?, is_vip \u003d 1, updated_at \u003d CURRENT_TIMESTAMP WHERE id \u003d ?\u0027)\n        .run(VIP_GOLD_COST, user.id);\n\n      const orderCode \u003d \u0027GLD\u0027 + Date.now().toString().slice(-8);\n      db.prepare(`\n        INSERT INTO orders (order_code, user_id, order_type, amount, gold_amount, payment_method, status, transfer_content, note)\n        VALUES (?, ?, \u0027VIP_UPGRADE\u0027, ?, ?, \u0027GOLD_BALANCE\u0027, \u0027COMPLETED\u0027, ?, \u0027Đổi gói VIP bằng Gold thành công\u0027)\n      `).run(orderCode, user.id, VIP_GOLD_COST, VIP_GOLD_COST, `GOLD_BUY_VIP_${user.id}`);\n\n      const updatedUser \u003d db.prepare(\u0027SELECT id, username, full_name, phone_or_email, role, is_vip, gold_balance, status FROM users WHERE id \u003d ?\u0027).get(user.id);\n\n      return sendJson(res, 200, {\n        success: true,\n        message: \u0027Đã đổi gói VIP thành công từ số dư Gold!\u0027,\n        user: updatedUser\n      });\n    }\n\n    // -------------------------------------------------------------\n    // ADMIN DASHBOARD APIS (YÊU CẦU QUYỀN ADMIN)\n    // -------------------------------------------------------------\n    if (pathname.startsWith(\u0027/api/admin/\u0027)) {\n      const user \u003d getAuthUser(req);\n      if (!user || user.role !\u003d\u003d \u0027admin\u0027) {\n        return sendJson(res, 403, { success: false, message: \u0027Bạn không có quyền quản trị viên (Admin)!\u0027 });\n      }\n\n      // 7.1 Thống kê tổng quan Dashboard\n      if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/admin/stats\u0027) {\n        const totalUsers \u003d db.prepare(\u0027SELECT COUNT(*) AS c FROM users\u0027).get().c;\n        const totalVip \u003d db.prepare(\u0027SELECT COUNT(*) AS c FROM users WHERE is_vip \u003d 1\u0027).get().c;\n        const totalOrders \u003d db.prepare(\u0027SELECT COUNT(*) AS c FROM orders\u0027).get().c;\n        const totalRevenue \u003d db.prepare(\"SELECT COALESCE(SUM(amount), 0) AS rev FROM orders WHERE status \u003d \u0027COMPLETED\u0027\").get().rev;\n        const pendingOrders \u003d db.prepare(\"SELECT COUNT(*) AS c FROM orders WHERE status \u003d \u0027PENDING\u0027\").get().c;\n        const totalQuestions \u003d db.prepare(\u0027SELECT COUNT(*) AS c FROM questions\u0027).get().c;\n        const todayViews \u003d db.prepare(\"SELECT COUNT(*) AS c FROM site_analytics WHERE visited_at \u003d CURRENT_DATE\").get().c;\n        const totalViews \u003d db.prepare(\u0027SELECT COUNT(*) AS c FROM site_analytics\u0027).get().c;\n\n        return sendJson(res, 200, {\n          success: true,\n          stats: {\n            online_users: Math.max(1, onlineUsers.size),\n            today_views: todayViews,\n            total_views: totalViews,\n            total_users: totalUsers,\n            total_vip: totalVip,\n            total_orders: totalOrders,\n            pending_orders: pendingOrders,\n            total_revenue: totalRevenue,\n            formatted_revenue: totalRevenue.toLocaleString(\u0027vi-VN\u0027) + \u0027 đ\u0027,\n            total_questions: totalQuestions\n          }\n        });\n      }\n\n      // 7.2 Quản lý người dùng\n      if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/admin/users\u0027) {\n        const search \u003d parsedUrl.query.search || \u0027\u0027;\n        let sql \u003d \u0027SELECT id, username, full_name, phone_or_email, role, is_vip, gold_balance, status, created_at FROM users WHERE 1\u003d1\u0027;\n        const params \u003d [];\n        if (search) {\n          sql +\u003d \u0027 AND (full_name LIKE ? OR phone_or_email LIKE ? OR username LIKE ?)\u0027;\n          params.push(`%${search}%`, `%${search}%`, `%${search}%`);\n        }\n        sql +\u003d \u0027 ORDER BY id DESC\u0027;\n        const users \u003d db.prepare(sql).all(...params);\n        return sendJson(res, 200, { success: true, users });\n      }\n\n      // Cộng Gold / Trừ Gold\n      if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/admin/users/gold\u0027) {\n        const body \u003d await parseJsonBody(req);\n        const { user_id, amount, action } \u003d body; // action: \u0027add\u0027 or \u0027subtract\u0027\n        const numAmount \u003d parseInt(amount, 10);\n        if (!user_id || isNaN(numAmount) || numAmount \u003c\u003d 0) {\n          return sendJson(res, 400, { success: false, message: \u0027Số Gold và User ID không hợp lệ\u0027 });\n        }\n\n        const delta \u003d action \u003d\u003d\u003d \u0027subtract\u0027 ? -numAmount : numAmount;\n        db.prepare(\u0027UPDATE users SET gold_balance \u003d MAX(0, gold_balance + ?), updated_at \u003d CURRENT_TIMESTAMP WHERE id \u003d ?\u0027)\n          .run(delta, user_id);\n\n        const targetUser \u003d db.prepare(\u0027SELECT id, full_name, gold_balance FROM users WHERE id \u003d ?\u0027).get(user_id);\n        return sendJson(res, 200, {\n          success: true,\n          message: `Đã ${action \u003d\u003d\u003d \u0027subtract\u0027 ? \u0027trừ\u0027 : \u0027cộng\u0027} ${numAmount.toLocaleString()} Gold cho học viên ${targetUser.full_name}.`,\n          user: targetUser\n        });\n      }\n\n      // Kích hoạt VIP thủ công / Hủy VIP\n      if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/admin/users/vip\u0027) {\n        const body \u003d await parseJsonBody(req);\n        const { user_id, is_vip } \u003d body;\n        db.prepare(\u0027UPDATE users SET is_vip \u003d ?, updated_at \u003d CURRENT_TIMESTAMP WHERE id \u003d ?\u0027).run(is_vip ? 1 : 0, user_id);\n        return sendJson(res, 200, { success: true, message: `Đã ${is_vip ? \u0027kích hoạt VIP\u0027 : \u0027hủy quyền VIP\u0027} thành công!` });\n      }\n\n      // Khóa / Mở khóa tài khoản\n      if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/admin/users/status\u0027) {\n        const body \u003d await parseJsonBody(req);\n        const { user_id, status } \u003d body;\n        db.prepare(\u0027UPDATE users SET status \u003d ?, updated_at \u003d CURRENT_TIMESTAMP WHERE id \u003d ?\u0027).run(status, user_id);\n        return sendJson(res, 200, { success: true, message: `Đã cập nhật trạng thái tài khoản thành ${status}!` });\n      }\n\n      // 7.3 Quản lý đơn hàng\n      if (method \u003d\u003d\u003d \u0027GET\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/admin/orders\u0027) {\n        const orders \u003d db.prepare(`\n          SELECT o.*, u.full_name, u.phone_or_email\n          FROM orders o\n          JOIN users u ON o.user_id \u003d u.id\n          ORDER BY o.id DESC\n        `).all();\n        return sendJson(res, 200, { success: true, orders });\n      }\n\n      // Duyệt đơn / Từ chối đơn\n      if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/admin/orders/action\u0027) {\n        const body \u003d await parseJsonBody(req);\n        const { order_id, action } \u003d body; // \u0027APPROVE\u0027 hoặc \u0027REJECT\u0027\n        const order \u003d db.prepare(\u0027SELECT * FROM orders WHERE id \u003d ?\u0027).get(order_id);\n        if (!order) return sendJson(res, 404, { success: false, message: \u0027Không tìm thấy đơn hàng\u0027 });\n\n        if (action \u003d\u003d\u003d \u0027APPROVE\u0027) {\n          db.prepare(\"UPDATE orders SET status \u003d \u0027COMPLETED\u0027, updated_at \u003d CURRENT_TIMESTAMP WHERE id \u003d ?\").run(order_id);\n          // Tự động nâng cấp VIP nếu là đơn VIP\n          if (order.order_type \u003d\u003d\u003d \u0027VIP_UPGRADE\u0027) {\n            db.prepare(\u0027UPDATE users SET is_vip \u003d 1 WHERE id \u003d ?\u0027).run(order.user_id);\n          } else if (order.order_type \u003d\u003d\u003d \u0027GOLD_DEPOSIT\u0027 \u0026\u0026 order.gold_amount \u003e 0) {\n            db.prepare(\u0027UPDATE users SET gold_balance \u003d gold_balance + ? WHERE id \u003d ?\u0027).run(order.gold_amount, order.user_id);\n          }\n          return sendJson(res, 200, { success: true, message: \u0027Đã duyệt đơn hàng thành công!\u0027 });\n        } else {\n          db.prepare(\"UPDATE orders SET status \u003d \u0027REJECTED\u0027, updated_at \u003d CURRENT_TIMESTAMP WHERE id \u003d ?\").run(order_id);\n          return sendJson(res, 200, { success: true, message: \u0027Đã từ chối đơn hàng.\u0027 });\n        }\n      }\n\n      // 7.4 Cấu hình hệ thống (Thay đổi URL Logo, Giá VIP, Banner...)\n      if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/admin/settings\u0027) {\n        const body \u003d await parseJsonBody(req);\n        const { settings } \u003d body;\n        if (settings \u0026\u0026 typeof settings \u003d\u003d\u003d \u0027object\u0027) {\n          const updateStmt \u003d db.prepare(\u0027INSERT OR REPLACE INTO system_settings (key, value, updated_at) VALUES (?, ?, CURRENT_TIMESTAMP)\u0027);\n          for (const [key, value] of Object.entries(settings)) {\n            updateStmt.run(key, String(value));\n          }\n        }\n        return sendJson(res, 200, { success: true, message: \u0027Đã lưu cấu hình hệ thống \u0026 Logo ứng dụng thành công!\u0027 });\n      }\n\n      // 7.5 Quản lý câu hỏi \u0026 Mẹo trả lời nhanh\n      if (method \u003d\u003d\u003d \u0027POST\u0027 \u0026\u0026 pathname \u003d\u003d\u003d \u0027/api/admin/questions\u0027) {\n        const body \u003d await parseJsonBody(req);\n        const {\n          id,\n          license_tiers,\n          category,\n          question_text,\n          image_url,\n          options,\n          correct_option_index,\n          explanation,\n          is_critical,\n          quick_tip\n        } \u003d body;\n\n        if (!question_text || !options || correct_option_index \u003d\u003d\u003d undefined) {\n          return sendJson(res, 400, { success: false, message: \u0027Vui lòng điền nội dung câu hỏi và các phương án!\u0027 });\n        }\n\n        const optionsJson \u003d typeof options \u003d\u003d\u003d \u0027string\u0027 ? options : JSON.stringify(options);\n        const tiersJson \u003d typeof license_tiers \u003d\u003d\u003d \u0027string\u0027 ? license_tiers : JSON.stringify(license_tiers || [\u0027A1\u0027, \u0027B2\u0027]);\n\n        let questionId \u003d id;\n        if (id) {\n          // Update\n          db.prepare(`\n            UPDATE questions\n            SET license_tiers \u003d ?, category \u003d ?, question_text \u003d ?, image_url \u003d ?, options \u003d ?,\n                correct_option_index \u003d ?, explanation \u003d ?, is_critical \u003d ?\n            WHERE id \u003d ?\n          `).run(tiersJson, category, question_text, image_url || \u0027\u0027, optionsJson, correct_option_index, explanation || \u0027\u0027, is_critical ? 1 : 0, id);\n        } else {\n          // Insert\n          const info \u003d db.prepare(`\n            INSERT INTO questions (license_tiers, category, question_text, image_url, options, correct_option_index, explanation, is_critical)\n            VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n          `).run(tiersJson, category, question_text, image_url || \u0027\u0027, optionsJson, correct_option_index, explanation || \u0027\u0027, is_critical ? 1 : 0);\n          questionId \u003d info.lastInsertRowid;\n        }\n\n        // Cập nhật Mẹo 3 Giây\n        if (quick_tip) {\n          db.prepare(`\n            INSERT INTO quick_tips (question_id, tip_title, tip_keyword, tip_rule, tip_mnemonic, speed_seconds)\n            VALUES (?, ?, ?, ?, ?, ?)\n            ON CONFLICT(question_id) DO UPDATE SET\n              tip_title \u003d excluded.tip_title,\n              tip_keyword \u003d excluded.tip_keyword,\n              tip_rule \u003d excluded.tip_rule,\n              tip_mnemonic \u003d excluded.tip_mnemonic,\n              speed_seconds \u003d excluded.speed_seconds\n          `).run(\n            questionId,\n            quick_tip.tip_title || \u0027⚡ Mẹo 3s Siêu Tốc\u0027,\n            quick_tip.tip_keyword || \u0027\u0027,\n            quick_tip.tip_rule || \u0027\u0027,\n            quick_tip.tip_mnemonic || \u0027\u0027,\n            quick_tip.speed_seconds || 3\n          );\n        }\n\n        return sendJson(res, 200, { success: true, message: \u0027Đã lưu câu hỏi và Mẹo 3s thành công!\u0027, question_id: questionId });\n      }\n\n      if (method \u003d\u003d\u003d \u0027DELETE\u0027 \u0026\u0026 pathname.startsWith(\u0027/api/admin/questions/\u0027)) {\n        const questionId \u003d pathname.split(\u0027/\u0027).pop();\n        db.prepare(\u0027DELETE FROM quick_tips WHERE question_id \u003d ?\u0027).run(questionId);\n        db.prepare(\u0027DELETE FROM questions WHERE id \u003d ?\u0027).run(questionId);\n        return sendJson(res, 200, { success: true, message: \u0027Đã xóa câu hỏi thành công!\u0027 });\n      }\n    }\n\n    // 8. PHỤC VỤ STATIC FILES FRONTEND\n    return serveStaticFile(req, res, pathname);\n\n  } catch (err) {\n    console.error(\u0027[Server Error]\u0027, err);\n    return sendJson(res, 500, { success: false, message: \u0027Lỗi máy chủ nội bộ: \u0027 + err.message });\n  }\n});\n\nserver.listen(PORT, \u00270.0.0.0\u0027, () \u003d\u003e {\n  console.log(`\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d`);\n  console.log(`🚀 [Mẹo Thi Bằng N.Sown] Máy chủ đã khởi động tại: http://localhost:${PORT}`);\n  console.log(`👑 Đã tích hợp hệ thống Mẹo 3s \u0026 VietQR chuẩn xác!`);\n  console.log(`\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003